<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Log In | ScaleEngine</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <style>
    :root { --dark: #0f172a; --text: #1e293b; --muted: #64748b; --line: #e2e8f0; --bg: #f8fafc; }
    * { box-sizing: border-box; }
    body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 32px 18px; color: var(--text); background: var(--bg); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .login-card { width: min(100%, 460px); padding: 38px 36px; border: 1px solid var(--line); border-radius: 12px; background: #fff; box-shadow: 0 10px 30px rgba(0, 0, 0, .05); text-align: center; animation: appear .4s ease both; }
    .brand { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 22px; text-decoration: none; color: var(--dark); }
    .brand-badge { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 10px; color: #fff; background: linear-gradient(135deg, #1e293b, #0f172a); font-size: 22px; box-shadow: 0 4px 12px rgba(0, 0, 0, .18); }
    .brand-text { text-align: left; }
    .brand-text strong { display: block; font-size: 20px; font-weight: 800; letter-spacing: -.02em; color: var(--dark); line-height: 1.1; }
    .brand-text span { font-size: 10px; font-weight: 700; letter-spacing: .14em; color: var(--muted); text-transform: uppercase; }
    .intro { margin: 0 0 24px; color: var(--muted); font-size: 14.5px; line-height: 1.5; }
    form { text-align: left; }
    .field { margin-bottom: 18px; }
    label { display: flex; justify-content: space-between; align-items: center; margin-bottom: 7px; font-size: 13.5px; font-weight: 600; color: #334155; }
    label a { color: #475569; text-decoration: none; font-weight: 500; font-size: 13px; }
    label a:hover { color: #0f172a; text-decoration: underline; }
    input { width: 100%; height: 46px; padding: 0 14px; border: 1px solid var(--line); border-radius: 6px; color: var(--text); background: #fdfdfd; font-size: 14.5px; outline: none; transition: border-color .15s, box-shadow .15s; }
    input:focus { border-color: #0f172a; box-shadow: 0 0 0 3px rgba(15, 23, 42, .1); background: #fff; }
    .password-wrap { position: relative; }
    .password-wrap input { padding-right: 44px; }
    .toggle { position: absolute; right: 12px; top: 11px; border: 0; padding: 0; color: #64748b; background: transparent; cursor: pointer; font-size: 18px; }
    .captcha { height: 90px; display: grid; place-items: center; margin-top: 20px; border: 1px solid var(--line); border-radius: 6px; color: #0f172a; background: repeating-linear-gradient(135deg, #f8fafc 0 8px, #f1f5f9 9px 12px); font: 700 34px -apple-system, BlinkMacSystemFont, monospace; letter-spacing: 14px; user-select: none; }
    .captcha span { transform: skew(-6deg); }
    .captcha-input { margin-top: 8px; }
    button[type='submit'] { width: 100%; height: 46px; margin-top: 18px; border: 0; border-radius: 6px; color: #fff; background: #0f172a; cursor: pointer; font-size: 14.5px; font-weight: 600; transition: background .15s, transform .15s; }
    button[type='submit']:hover { background: #000; transform: translateY(-1px); }
    .social-divider { display: flex; align-items: center; gap: 12px; margin: 20px 0 16px; color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
    .social-divider::before, .social-divider::after { content: ''; flex: 1; height: 1px; background: var(--line); }
    .btn-google { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 46px; border: 1px solid var(--line); border-radius: 6px; color: #1e293b; background: #fff; font-size: 14px; font-weight: 600; cursor: pointer; transition: all .15s ease; }
    .btn-google:hover { background: #f8fafc; border-color: #cbd5e1; box-shadow: 0 2px 8px rgba(0, 0, 0, .06); }
    .btn-google svg { width: 18px; height: 18px; }
    .register { margin-top: 24px; color: var(--muted); text-align: center; font-size: 14px; }
    .register a { color: #0f172a; font-weight: 600; text-decoration: none; }
    .register a:hover { text-decoration: underline; }
    .status { min-height: 20px; margin: 12px 0 0; text-align: center; color: #dc2626; font-size: 13px; font-weight: 500; }
    @@keyframes appear { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    @@media (max-width: 520px) { .login-card { padding: 28px 20px; } }
  </style>
</head>
<body>
  <main class="login-card">
    <div class="brand" aria-label="ScaleEngine logo">
      <div class="brand-badge"><i class="bi bi-cpu-fill"></i></div>
      <div class="brand-text">
        <strong>ScaleEngine</strong>
        <span>MLM PLATFORM</span>
      </div>
    </div>
    <p class="intro">Please sign in to your account and start the adventure</p>
    <form id="loginForm" novalidate>
      <div class="field">
        <label for="userId">User ID</label>
        <input id="userId" name="userId" placeholder="Enter your User ID" autocomplete="username" required>
      </div>
      <div class="field">
        <label for="password"><span>Password</span><a href="forgot-password.html">Forgot Password ?</a></label>
        <div class="password-wrap">
          <input id="password" name="password" type="password" placeholder="••••••••••••" autocomplete="current-password" required>
          <button class="toggle" type="button" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye"></i></button>
        </div>
      </div>
      <div class="captcha" aria-label="CAPTCHA example"><span>e p W b</span></div>
      <input class="captcha-input" id="captcha" name="captcha" placeholder="Enter captcha characters above" required>
      <button type="submit">Log In</button>
      
      <div class="social-divider"><span>or continue with</span></div>

      <button class="btn-google" id="googleBtn" type="button">
        <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17Z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.26v3.15C3.25 21.36 7.33 24 12 24Z"/><path fill="#FBBC05" d="M5.28 14.27a7.17 7.17 0 0 1 0-4.54V6.58H1.26a11.96 11.96 0 0 0 0 10.84l4.02-3.15Z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.25 2.64 1.26 6.58l4.02 3.15c.95-2.83 3.6-4.93 6.72-4.93Z"/></svg>
        <span>Sign in with Google</span>
      </button>

      <div style="margin-top:14px; text-align:center;">
        <button type="button" class="btn-saas-demo" style="width:100%; height:40px; border:1px dashed #cbd5e1; border-radius:6px; background:#f8fafc; color:#0284c7; font-size:13px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; gap:7px;">
          <i class="bi bi-palette-fill"></i> Customize SaaS Demo Brand &amp; Colors
        </button>
      </div>

      <p id="status" class="status" role="status" aria-live="polite"></p>
    </form>
    <p class="register">New on our platform? <a href="vitality-registration.html">Register New Account</a></p>
  </main>
  <script>
    const password = document.querySelector('#password');
    const toggle = document.querySelector('.toggle');
    const form = document.querySelector('#loginForm');
    const status = document.querySelector('#status');
    const googleBtn = document.querySelector('#googleBtn');
    let configuredGoogleClientId = null;

    // Load Google OAuth Configuration from Backend
    fetch('/api/auth/config')
      .then((r) => r.ok ? r.json() : null)
      .then((cfg) => {
        if (cfg?.googleClientId && cfg.googleClientId.includes('.apps.googleusercontent.com') && !cfg.googleClientId.startsWith('YOUR_')) {
          configuredGoogleClientId = cfg.googleClientId;
          if (window.google?.accounts?.id) {
            initGoogleGsi();
          } else {
            window.addEventListener('load', () => { if (window.google?.accounts?.id) initGoogleGsi(); });
          }
        }
      })
      .catch(() => {});

    function handleGoogleResponse(response) {
      if (!response.credential) return;
      status.style.color = '#0f172a';
      status.textContent = 'Verifying Google credentials with ScaleEngine...';
      fetch('/api/auth/google', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ idToken: response.credential })
      })
      .then((r) => r.json().then((data) => ({ ok: r.ok, data })))
      .then(({ ok, data }) => {
        if (ok && data.accessToken) {
          localStorage.setItem('vitality.accessToken', data.accessToken);
          status.style.color = '#16a34a';
          status.textContent = 'Google sign-in successful! Redirecting...';
          window.setTimeout(() => { window.location.href = 'dashboard.html'; }, 400);
        } else {
          status.style.color = '#dc2626';
          status.textContent = data.message || 'Google authentication failed.';
        }
      })
      .catch(() => {
        status.style.color = '#dc2626';
        status.textContent = 'Unable to connect to authentication server.';
      });
    }

    function initGoogleGsi() {
      if (!configuredGoogleClientId || !window.google?.accounts?.id) return;
      google.accounts.id.initialize({
        client_id: configuredGoogleClientId,
        callback: handleGoogleResponse,
        auto_select: false
      });
    }

    toggle.addEventListener('click', () => {
      const visible = password.type === 'text';
      password.type = visible ? 'password' : 'text';
      toggle.setAttribute('aria-pressed', String(!visible));
      toggle.innerHTML = visible ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
      toggle.setAttribute('aria-label', visible ? 'Show password' : 'Hide password');
    });

    googleBtn.addEventListener('click', async () => {
      if (configuredGoogleClientId && window.google?.accounts?.id) {
        google.accounts.id.prompt((notification) => {
          if (notification.isNotDisplayed() || notification.isSkippedMoment()) {
            promptGoogleEmailFallback();
          }
        });
      } else {
        promptGoogleEmailFallback();
      }
    });

    async function promptGoogleEmailFallback() {
      const userEmail = prompt('Enter your Gmail / Google account email:', 'samkelisojam285@gmail.com');
      if (!userEmail) return;
      status.style.color = '#0f172a';
      status.textContent = 'Authenticating with Google...';
      try {
        const response = await fetch('/api/auth/google', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: userEmail, name: userEmail.split('@@')[0] })
        });
        const result = await response.json();
        if (response.ok && result.accessToken) {
          localStorage.setItem('vitality.accessToken', result.accessToken);
          status.style.color = '#16a34a';
          status.textContent = 'Google sign-in successful! Redirecting...';
          window.setTimeout(() => { window.location.href = 'dashboard.html'; }, 400);
        } else {
          status.style.color = '#dc2626';
          status.textContent = result.message || 'Google authentication failed.';
        }
      } catch {
        status.style.color = '#dc2626';
        status.textContent = 'Unable to connect to Google authentication service.';
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      try {
        const response = await fetch('/api/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId: userId.value, password: password.value, captcha: captcha.value }) });
        const result = await response.json();
        status.textContent = result.message || 'Unable to sign in.';
        if (response.ok && result.accessToken) { localStorage.setItem('vitality.accessToken', result.accessToken); window.setTimeout(() => { window.location.href = 'dashboard.html'; }, 350); }
      } catch { status.textContent = 'Unable to contact the server.'; }
    });
  </script>
  <script src="/js/saas-engine.js?v=1"></script>
</body>
</html>
