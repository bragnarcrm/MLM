@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Transaction Password & Security History";
}

<div class="trans-pwd-container">
  <!-- Main Change / Generate Card -->
  <section class="panel">
    <div class="panel-head">
      <div class="panel-icon"><i class="bi bi-shield-lock-fill"></i></div>
      <div>
        <h1>Change Transaction Password</h1>
        <p class="subtitle">Your transaction password is required to authorize withdrawals, bank changes, and wallet transfers.</p>
      </div>
    </div>

    <div class="message" id="currentTransMessage">
      <i class="bi bi-info-circle text-primary"></i>
      <span>Generate a new secure PIN or set your custom transaction authorization password below.</span>
    </div>

    <div class="actions-row">
      <button type="button" class="btn-generate-pin" id="generateBtn">
        <i class="bi bi-key-fill"></i> Generate Transaction Password
      </button>
      <button type="button" class="btn-toggle-custom" id="toggleCustomBtn">
        <i class="bi bi-pencil-square"></i> Set Custom Password
      </button>
    </div>

    <!-- Custom Password Form -->
    <form id="customPasswordForm" style="display:none; margin-top:20px;">
      <div class="field">
        <label for="newTransPwd">New Transaction Password *</label>
        <input id="newTransPwd" type="password" placeholder="At least 4 characters" minlength="4" required>
      </div>
      <div class="field" style="margin-top:12px;">
        <label for="confirmTransPwd">Confirm Transaction Password *</label>
        <input id="confirmTransPwd" type="password" placeholder="Repeat transaction password" minlength="4" required>
      </div>
      <div style="margin-top:16px;">
        <button type="submit" class="btn-save-custom" id="saveCustomBtn"><i class="bi bi-check2-circle"></i> Save Transaction Password</button>
      </div>
    </form>

    <div class="status" id="status" role="status" aria-live="polite"></div>
  </section>

  <!-- History & Audit Trail Underneath -->
  <section class="panel history-panel">
    <div class="history-head">
      <div>
        <h2><i class="bi bi-clock-history"></i> Transaction Password History &amp; Audit Trail</h2>
        <p class="subtitle">Complete chronological record of all generated security PINs and password updates.</p>
      </div>
      <button type="button" class="btn-refresh-history" id="refreshHistoryBtn" title="Refresh history">
        <i class="bi bi-arrow-clockwise"></i> Refresh
      </button>
    </div>

    <div class="table-wrap">
      <table class="history-table">
        <thead>
          <tr>
            <th style="width:60px;">#</th>
            <th style="width:160px;">Date &amp; Time</th>
            <th style="width:220px;">Security Action</th>
            <th>Remarks / Details</th>
            <th style="width:140px;">Status</th>
            <th style="width:110px;">IP / Channel</th>
          </tr>
        </thead>
        <tbody id="historyRows">
          <tr><td colspan="6" class="empty-cell">Loading security history...</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</div>

@section Styles {
<style>
  :root {
    --dark: #0f172a;
    --line: #e2e8f0;
    --paper: #fff;
    --muted: #64748b;
    --success: #16a34a;
    --danger: #dc2626;
  }
  * { box-sizing: border-box; }

  .trans-pwd-container { max-width: 880px; margin: 0 auto; display: flex; flex-direction: column; gap: 26px; }

  .panel { padding: 30px 32px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); box-shadow: 0 4px 18px rgba(0,0,0,.04); }
  .panel-head { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
  .panel-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 10px; background: #0f172a; color: #fff; font-size: 22px; flex-shrink: 0; }
  h1 { margin: 0 0 4px; font-size: 21px; font-weight: 700; color: var(--dark); }
  h2 { margin: 0 0 4px; font-size: 16.5px; font-weight: 700; color: var(--dark); display: flex; align-items: center; gap: 8px; }
  .subtitle { margin: 0; color: var(--muted); font-size: 13.5px; }

  .message { display: flex; align-items: center; gap: 10px; margin-bottom: 22px; padding: 14px 18px; border: 1px solid #e2e8f0; border-radius: 8px; color: #334155; background: #f8fafc; font-size: 13.5px; line-height: 1.5; }
  
  .actions-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-generate-pin { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 22px; border: 0; border-radius: 6px; background: var(--dark); color: #fff; font-size: 13.5px; font-weight: 700; cursor: pointer; transition: background .15s; }
  .btn-generate-pin:hover { background: #000; }
  
  .btn-toggle-custom { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border: 1px solid var(--line); border-radius: 6px; background: #fff; color: var(--dark); font-size: 13.5px; font-weight: 600; cursor: pointer; }
  .btn-toggle-custom:hover { background: #f8fafc; }

  .field { display: flex; flex-direction: column; gap: 6px; }
  label { font-size: 13px; font-weight: 600; color: #334155; }
  input { width: 100%; height: 42px; padding: 0 13px; border: 1px solid var(--line); border-radius: 6px; color: #1e293b; background: #fdfdfd; font: 14px -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; outline: none; }
  input:focus { border-color: var(--dark); box-shadow: 0 0 0 3px rgba(15, 23, 42, .08); background: #fff; }

  .btn-save-custom { display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 20px; border: 0; border-radius: 6px; background: #1e293b; color: #fff; font-size: 13.5px; font-weight: 700; cursor: pointer; }
  .btn-save-custom:hover { background: #0f172a; }

  .status { min-height: 20px; margin: 18px 0 0; font-size: 13.5px; font-weight: 600; color: var(--success); }
  .status.error { color: var(--danger); }

  /* History Table Underneath */
  .history-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 12px; }
  .btn-refresh-history { display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 12px; border: 1px solid var(--line); border-radius: 6px; background: #fff; color: var(--muted); font-size: 12px; font-weight: 600; cursor: pointer; }
  .btn-refresh-history:hover { background: #f8fafc; color: var(--dark); }

  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
  .history-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .history-table th, .history-table td { padding: 12px 14px; border-bottom: 1px solid var(--line); text-align: left; }
  .history-table th { background: #f8fafc; color: var(--muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .history-table tbody tr:hover { background: #f8fafc; }
  .empty-cell { padding: 30px 14px; text-align: center; color: var(--muted); }

  .badge-history-status { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
  .badge-history-status.expired { background: #f1f5f9; color: #64748b; border-color: #cbd5e1; }

  @@media (max-width: 650px) {
    .panel { padding: 22px 18px; }
    .actions-row { flex-direction: column; }
    .btn-generate-pin, .btn-toggle-custom { width: 100%; justify-content: center; }
  }
</style>
}

@section Scripts {
<script>
(() => {
  const token = localStorage.getItem('vitality.accessToken');
  const authHeaders = () => ({ 'Content-Type': 'application/json', Authorization: `Bearer ${token || ''}` });

  const status = document.querySelector('#status');
  const generateBtn = document.querySelector('#generateBtn');
  const toggleCustomBtn = document.querySelector('#toggleCustomBtn');
  const customForm = document.querySelector('#customPasswordForm');
  const saveCustomBtn = document.querySelector('#saveCustomBtn');
  const newTransPwd = document.querySelector('#newTransPwd');
  const confirmTransPwd = document.querySelector('#confirmTransPwd');
  const historyRows = document.querySelector('#historyRows');
  const refreshHistoryBtn = document.querySelector('#refreshHistoryBtn');

  // Toggle Custom Form
  toggleCustomBtn.addEventListener('click', () => {
    const isHidden = customForm.style.display === 'none';
    customForm.style.display = isHidden ? 'block' : 'none';
    toggleCustomBtn.classList.toggle('active', isHidden);
    if (isHidden) newTransPwd.focus();
  });

  // Load History
  const loadHistory = async () => {
    if (!token) return;
    try {
      const res = await fetch('/api/credentials/transaction-password/history', { headers: authHeaders() });
      if (!res.ok) {
        historyRows.innerHTML = '<tr><td colspan="6" class="empty-cell">No history available yet.</td></tr>';
        return;
      }
      const logs = await res.json();
      if (!Array.isArray(logs) || logs.length === 0) {
        historyRows.innerHTML = '<tr><td colspan="6" class="empty-cell">No transaction password history logged yet.</td></tr>';
        return;
      }

      historyRows.innerHTML = logs.map((log, idx) => {
        const timeStr = new Date(log.occurredAt).toLocaleString([], { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        const isCurrent = idx === 0;
        const statusBadge = isCurrent
          ? `<span class="badge-history-status"><i class="bi bi-shield-check"></i> ${log.status}</span>`
          : `<span class="badge-history-status expired"><i class="bi bi-check2"></i> Archived</span>`;

        return `<tr>
          <td style="color:var(--muted); font-weight:600;">${idx + 1}</td>
          <td style="white-space:nowrap; font-size:12px; color:var(--muted);">${timeStr}</td>
          <td><strong>${log.action}</strong></td>
          <td style="font-size:12.5px; color:#334155;">${log.remarks}</td>
          <td>${statusBadge}</td>
          <td><code style="font-size:11px; color:#475569;">${log.ipAddress || '127.0.0.1'}</code></td>
        </tr>`;
      }).join('');
    } catch {
      historyRows.innerHTML = '<tr><td colspan="6" class="empty-cell">Unable to load transaction password history.</td></tr>';
    }
  };

  loadHistory();
  refreshHistoryBtn.addEventListener('click', loadHistory);

  // Generate Transaction Password
  generateBtn.addEventListener('click', async () => {
    generateBtn.disabled = true;
    status.className = 'status';
    status.textContent = 'Generating new transaction authorization PIN...';

    try {
      const res = await fetch('/api/credentials/transaction-password/generate', {
        method: 'POST',
        headers: authHeaders()
      });
      const result = await res.json();
      if (res.ok && result.succeeded) {
        status.className = 'status';
        status.textContent = result.message || 'Transaction password generated successfully.';
        loadHistory();
      } else {
        status.className = 'status error';
        status.textContent = result.message || 'Could not generate transaction password.';
      }
    } catch {
      status.className = 'status error';
      status.textContent = 'Unable to connect to server.';
    } finally {
      generateBtn.disabled = false;
    }
  });

  // Save Custom Password
  customForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!customForm.checkValidity()) { customForm.reportValidity(); return; }

    const pwd = newTransPwd.value;
    const confirmPwd = confirmTransPwd.value;
    if (pwd !== confirmPwd) {
      status.className = 'status error';
      status.textContent = 'Passwords do not match.';
      return;
    }

    saveCustomBtn.disabled = true;
    status.className = 'status';
    status.textContent = 'Saving custom transaction password...';

    try {
      const res = await fetch('/api/credentials/transaction-password', {
        method: 'PUT',
        headers: authHeaders(),
        body: JSON.stringify({
          transactionPassword: pwd,
          confirmPassword: confirmPwd
        })
      });
      const result = await res.json();
      if (res.ok && result.succeeded) {
        status.className = 'status';
        status.textContent = result.message || 'Custom transaction password saved successfully.';
        customForm.reset();
        customForm.style.display = 'none';
        loadHistory();
      } else {
        status.className = 'status error';
        status.textContent = result.message || 'Could not save transaction password.';
      }
    } catch {
      status.className = 'status error';
      status.textContent = 'Unable to connect to server.';
    } finally {
      saveCustomBtn.disabled = false;
    }
  });
})();
</script>
}


