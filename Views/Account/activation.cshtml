@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Activation";
}

<section class="panel">
  <div class="panel-head">
    <div class="panel-icon"><i class="bi bi-shield-check"></i></div>
    <div>
      <h1>Partner Account Activation</h1>
      <p class="subtitle">Complete your one-time partner fee to activate commission earning and access full partner benefits.</p>
    </div>
  </div>

  <div id="activeBanner" class="active-badge" style="display:none;">
    <i class="bi bi-patch-check-fill"></i>
    <div>
      <strong>Your Account is Active</strong>
      <span>Your activation fee is paid and you are eligible for all direct and downline bonuses.</span>
    </div>
  </div>

  <form id="activationForm">
    <div class="grid">
      <div class="field">
        <label for="fee">Activation Fee (ZAR)</label>
        <div class="fee-display">R 90.00</div>
      </div>
      <div class="field">
        <label for="method">Payment Method</label>
        <select id="method" required>
          <option value="PayFast" selected>PayFast Gateway (Card, Instant EFT, QR)</option>
          <option value="Card">Direct Credit / Debit Card</option>
          <option value="Instant EFT">Instant EFT</option>
          <option value="Capitec Pay">Capitec Pay</option>
          <option value="Wallet">Scale Wallet Balance</option>
        </select>
      </div>
      <div class="actions">
        <a class="submit-link" id="payfastBtn" href="payfast-checkout.html?type=activation&amount=90&product=ScaleEngine+Account+Activation">
          <i class="bi bi-lock-fill"></i> Pay R 90.00 with PayFast
        </a>
        <a class="cancel" href="dashboard.html">Return to Dashboard</a>
      </div>
    </div>
    <p class="status" id="status" role="status" aria-live="polite"></p>
  </form>
</section>

@section Styles {
<style>
  :root { --dark: #0f172a; --deep: #0d0f12; --ink: #1e293b; --muted: #64748b; --line: #e2e8f0; --paper: #fff; --bg: #f8fafc; --success: #16a34a; }
  * { box-sizing: border-box; }
  .panel { padding: 32px 36px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); box-shadow: 0 8px 24px rgba(0, 0, 0, .04); max-width: 680px; margin: 0 auto; }
  .panel-head { display: flex; align-items: center; gap: 16px; margin-bottom: 26px; }
  .panel-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 10px; background: #0f172a; color: #fff; font-size: 22px; flex-shrink: 0; }
  h1 { margin: 0 0 4px; font-size: 20px; font-weight: 700; color: var(--dark); }
  .subtitle { margin: 0; color: var(--muted); font-size: 13.5px; }
  
  .active-badge { display: flex; align-items: center; gap: 14px; padding: 16px 20px; border-radius: 8px; background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; margin-bottom: 24px; font-size: 13.5px; }
  .active-badge i { font-size: 28px; color: #10b981; }
  .active-badge strong { display: block; font-size: 14.5px; font-weight: 700; margin-bottom: 2px; }

  .grid { display: grid; gap: 18px; }
  .field { display: grid; gap: 7px; }
  label { font-size: 13px; font-weight: 600; color: #334155; }
  .fee-display { display: flex; align-items: center; height: 48px; padding: 0 16px; border: 1px solid var(--line); border-radius: 6px; background: #f1f5f9; font-size: 18px; font-weight: 700; color: var(--dark); }
  select { height: 48px; padding: 0 14px; border: 1px solid var(--line); border-radius: 6px; color: var(--ink); background: #fdfdfd; font: 14px -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; outline: none; }
  select:focus { border-color: var(--dark); box-shadow: 0 0 0 3px rgba(15, 23, 42, .1); }

  .actions { display: flex; gap: 12px; margin-top: 10px; }
  .submit-link { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 48px; padding: 0 24px; border-radius: 6px; color: white; background: var(--dark); cursor: pointer; font-size: 14px; font-weight: 700; text-decoration: none; transition: background .15s, transform .15s; flex: 1; }
  .submit-link:hover { background: #000; color: #fff; transform: translateY(-1px); }
  .cancel { display: inline-flex; align-items: center; justify-content: center; height: 48px; padding: 0 20px; border: 1px solid var(--line); border-radius: 6px; color: var(--muted); background: #fff; text-decoration: none; font-size: 13.5px; font-weight: 600; }
  .cancel:hover { background: #f8fafc; color: var(--dark); }

  .status { min-height: 20px; margin: 14px 0 0; color: var(--success); font-size: 13px; font-weight: 600; text-align: center; }
  @@media (max-width: 600px) {
    .actions { flex-direction: column; }
    .panel { padding: 22px 18px; }
  }
</style>
}

@section Scripts {
<script>
  const token = localStorage.getItem('vitality.accessToken');
  const payfastBtn = document.querySelector('#payfastBtn');
  const method = document.querySelector('#method');

  method.addEventListener('change', () => {
    if (method.value === 'PayFast') {
      payfastBtn.href = 'payfast-checkout.html?type=activation&amount=90&product=ScaleEngine+Account+Activation';
      payfastBtn.innerHTML = '<i class="bi bi-lock-fill"></i> Pay R 90.00 with PayFast';
    } else {
      payfastBtn.href = `payfast-checkout.html?type=activation&amount=90&product=ScaleEngine+Account+Activation&method=${encodeURIComponent(method.value)}`;
      payfastBtn.innerHTML = `<i class="bi bi-credit-card-fill"></i> Pay R 90.00 via ${method.value}`;
    }
  });

  if (token) {
    fetch('/api/dashboard/summary', { headers: { Authorization: `Bearer ${token}` } })
      .then((r) => (r.ok ? r.json() : null))
      .then((summary) => {
        // Active check
      })
      .catch(() => {});
  }
</script>
}