@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Change Password";
}

<section class="panel"><h1>Change Password</h1><form id="passwordForm" novalidate><div class="grid"><div class="field"><label for="oldPassword">Enter Old Password <span>*</span></label><input id="oldPassword" type="password" placeholder="Enter Old Password" required></div><div class="field"><label for="newPassword">Enter New Password <span>*</span></label><input id="newPassword" type="password" minlength="8" placeholder="Enter New Password" required></div><div class="field"><label for="confirmPassword">Enter Confirm Password <span>*</span></label><input id="confirmPassword" type="password" placeholder="Enter Confirm Password" required></div><button type="submit">Change</button></div><p class="status" id="status" role="status" aria-live="polite"></p></form></section>

@section Styles {
<style>
:root { --green: #24272b; --deep: #14161a; --ink: #27372f; --muted: #7b857e; --paper: #fff; --bg: #f4f7f4; --line: #dce6de; }
    * { box-sizing: border-box; } body { margin: 0; color: var(--ink); background: var(--bg); font-family: 'Segoe UI', Tahoma, sans-serif; }
    .sidebar { position: fixed; inset: 0 auto 0 0; width: 248px; padding: 22px 14px; overflow-y: auto; color: #dce9de; background: var(--deep); } .brand { display: flex; align-items: center; gap: 11px; padding: 8px 10px 27px; color: white; font: italic 700 25px Georgia, serif; } .leaf { width: 28px; height: 35px; border-radius: 100% 0 100% 0; background: #3a3f45; transform: rotate(-25deg); }
    nav a, .nav-label { display: flex; align-items: center; gap: 12px; min-height: 39px; padding: 0 12px; border-radius: 5px; color: inherit; text-decoration: none; font-size: 13px; } nav a:hover, nav a.active { color: white; background: rgba(255,255,255,.13); } .icon { width: 19px; text-align: center; font-size: 16px; } .nav-label { min-height: 30px; margin-top: 12px; color: #8daf98; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; } .subnav { margin: 0 0 8px 31px; padding-left: 11px; border-left: 1px solid #466953; } .subnav a { min-height: 36px; padding-left: 7px; font-size: 12px; } .subnav a.active { color: white; background: rgba(255,255,255,.13); }
    .top { min-height: 68px; margin-left: 248px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; color: white; background: var(--deep); } .top a { color: #d8e9da; font-size: 13px; text-decoration: none; }
    main { width: min(calc(100% - 280px), 720px); margin: 28px auto 50px; } .panel { padding: 27px 32px 32px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper); box-shadow: 0 8px 24px rgba(30, 59, 39, .06); } h1 { margin: 0 0 24px; font-size: 21px; } .grid { display: grid; gap: 18px; } .field { display: grid; gap: 7px; } label { font-size: 13px; } label span { color: #bf7e21; } input { min-height: 45px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 4px; color: var(--ink); background: #fcfefd; font: 14px 'Segoe UI', sans-serif; outline: none; } input:focus { border-color: #6d9b70; box-shadow: 0 0 0 3px rgba(70, 135, 80, .12); } button { min-height: 45px; margin-top: 6px; border: 0; border-radius: 4px; color: white; background: var(--green); cursor: pointer; font-size: 13px; } button:hover { background: #000000; } .status { min-height: 20px; margin: 14px 0 0; color: #1f7a34; text-align: center; font-size: 13px; } .status.error { color: #b4473e; } footer { margin-left: 248px; padding: 20px; color: var(--muted); text-align: center; font-size: 11px; }
    @@media (max-width: 800px) { .sidebar { width: 62px; padding-left: 14px; padding-right: 14px; } .sidebar .brand span, .sidebar nav a span, .sidebar .nav-label, .sidebar .subnav { display: none; } nav a { justify-content: center; padding: 0; } .top, footer { margin-left: 62px; } main { width: min(calc(100% - 94px), 720px); } } @@media (max-width: 620px) { .sidebar { display: none; } .top, footer { margin-left: 0; } main { width: calc(100% - 20px); margin-top: 14px; } .panel { padding: 22px 18px 27px; } .top { padding: 0 16px; } }
</style>
}

@section Scripts {
<script>document.querySelector('#passwordForm').addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const status = document.querySelector('#status'); status.className = 'status'; status.textContent = ''; if (!form.checkValidity()) { form.reportValidity(); return; } try { const response = await fetch('/api/credentials/password', { method: 'PUT', headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${localStorage.getItem('vitality.accessToken') || ''}` }, body: JSON.stringify({ oldPassword: oldPassword.value, newPassword: newPassword.value, confirmPassword: confirmPassword.value }) }); const result = await response.json(); status.className = response.ok ? 'status' : 'status error'; status.textContent = result.message || 'Password could not be changed.'; } catch { status.className = 'status error'; status.textContent = 'Unable to contact the server.'; } });</script>
}


