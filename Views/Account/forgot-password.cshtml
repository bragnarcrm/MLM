<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Forgot Password | ScaleEngine</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <style>
    :root { --dark: #0f172a; --text: #1e293b; --muted: #64748b; --line: #e2e8f0; --bg: #f8fafc; }
    * { box-sizing: border-box; }
    body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 32px 18px; color: var(--text); background: var(--bg); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .login-card { width: min(100%, 460px); padding: 38px 36px; border: 1px solid var(--line); border-radius: 12px; background: #fff; box-shadow: 0 10px 30px rgba(0, 0, 0, .05); text-align: center; animation: appear .4s ease both; }
    .brand { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 22px; text-decoration: none; color: var(--dark); }
    .brand-badge { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 10px; color: #fff; background: linear-gradient(135deg, #1e293b, #0f172a); font-size: 22px; box-shadow: 0 4px 12px rgba(0, 0, 0, .18); }
    .brand-text { text-align: left; }
    .brand-text strong { display: block; font-size: 20px; font-weight: 800; letter-spacing: -.02em; color: var(--dark); line-height: 1.1; }
    .brand-text span { font-size: 10px; font-weight: 700; letter-spacing: .14em; color: var(--muted); text-transform: uppercase; }
    .intro { margin: 0 0 24px; color: var(--muted); font-size: 14px; line-height: 1.55; }
    form { text-align: left; }
    .field { margin-bottom: 18px; }
    label { display: block; margin-bottom: 7px; font-size: 13.5px; font-weight: 600; color: #334155; }
    input { width: 100%; height: 46px; padding: 0 14px; border: 1px solid var(--line); border-radius: 6px; color: var(--text); background: #fdfdfd; font-size: 14.5px; outline: none; transition: border-color .15s, box-shadow .15s; }
    input:focus { border-color: #0f172a; box-shadow: 0 0 0 3px rgba(15, 23, 42, .1); background: #fff; }
    button[type='submit'] { width: 100%; height: 46px; margin-top: 10px; border: 0; border-radius: 6px; color: #fff; background: #0f172a; cursor: pointer; font-size: 14.5px; font-weight: 600; transition: background .15s, transform .15s; }
    button[type='submit']:hover { background: #000; transform: translateY(-1px); }
    .back { margin-top: 22px; color: var(--muted); text-align: center; font-size: 14px; }
    .back a { color: #0f172a; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
    .back a:hover { text-decoration: underline; }
    .status { min-height: 30px; margin: 12px 0 0; text-align: center; color: #dc2626; font-size: 13px; font-weight: 500; word-break: break-word; }
    .status.success { color: #16a34a; }
    @@keyframes appear { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    @@media (max-width: 520px) { .login-card { padding: 28px 20px; } }
  </style>
</head>
<body>
  <main class="login-card">
    <div class="brand" aria-label="ScaleEngine logo">
      <div class="brand-badge"><i class="bi bi-cpu-fill"></i></div>
      <div class="brand-text">
        <strong>ScaleEngine</strong>
        <span>MLM PLATFORM</span>
      </div>
    </div>
    <p class="intro">Enter your username and the e-mail address on your account. We'll issue a temporary password you can sign in with.</p>
    <form id="forgotForm" novalidate>
      <div class="field">
        <label for="username">User ID</label>
        <input id="username" name="username" placeholder="Enter your User ID" autocomplete="username" required>
      </div>
      <div class="field">
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" placeholder="name@example.com" autocomplete="email" required>
      </div>
      <button type="submit">Send Reset</button>
      <p id="status" class="status" role="status" aria-live="polite"></p>
    </form>
    <p class="back"><a href="login.html"><i class="bi bi-arrow-left"></i> Back to Log In</a></p>
  </main>
  <script>
    const form = document.querySelector('#forgotForm');
    const status = document.querySelector('#status');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      try {
        const response = await fetch('/api/account/forgot-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: username.value, email: email.value }) });
        const result = await response.json();
        status.className = response.ok ? 'status success' : 'status';
        status.textContent = result.message || 'Unable to reset the password.';
      } catch { status.className = 'status'; status.textContent = 'Unable to contact the server.'; }
    });
  </script>
</body>
</html>
