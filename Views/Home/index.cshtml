  <script>
    const modal = document.querySelector('#requestDemoModal');
    const closeBtn = document.querySelector('#closeRequestDemoBtn');
    const form = document.querySelector('#demoRequestForm');

    const inputName = document.querySelector('#demoCompanyName');
    const inputSlogan = document.querySelector('#demoCompanySlogan');
    const customColor = document.querySelector('#demoCustomColor');
    const currencySelect = document.querySelector('#demoCurrency');

    const nichePresets = {
      wellness: { name: 'Aura Vitality Network', slogan: 'ORGANIC WELLNESS & HIGH-YIELD COMPENSATION', color: '#10b981', accent: '#34d399', icon: 'bi-heart-pulse-fill' },
      beauty: { name: 'Luxe Glow Cosmetics', slogan: 'PREMIUM SKINCARE & BEAUTY REVOLUTION', color: '#e11d48', accent: '#fb7185', icon: 'bi-gem' },
      crypto: { name: 'Apex FX & Crypto Academy', slogan: 'DIGITAL WEALTH & TRADING SIGNALS', color: '#8b5cf6', accent: '#a78bfa', icon: 'bi-currency-bitcoin' },
      solar: { name: 'SolarPeak Clean Energy', slogan: 'RENEWABLE ENERGY & CLEAN POWER COMMISSIONS', color: '#f59e0b', accent: '#fbbf24', icon: 'bi-sun-fill' }
    };

    let selectedColor = '#10b981';
    let selectedAccent = '#34d399';
    let selectedIcon = 'bi-heart-pulse-fill';
    let selectedNiche = 'wellness';

    inputName.value = nichePresets.wellness.name;
    inputSlogan.value = nichePresets.wellness.slogan;

    window.openRequestDemoModal = (planName) => {
      if (modal) {
        modal.style.display = 'flex';
        modal.setAttribute('aria-hidden', 'false');
        if (planName) {
          inputSlogan.value = `${planName.toUpperCase()} - 30-DAY ACTIVE SANDBOX`;
        }
      }
    };

    document.querySelector('#topRequestDemoBtn')?.addEventListener('click', () => window.openRequestDemoModal());
    document.querySelector('#heroRequestDemoBtn')?.addEventListener('click', () => window.openRequestDemoModal());

    closeBtn?.addEventListener('click', () => {
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.style.display = 'none';
        modal.setAttribute('aria-hidden', 'true');
      }
    });

    // Niche Preset Switcher
    document.querySelectorAll('.demo-niche-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.demo-niche-btn').forEach(b => {
          b.style.border = '1px solid #cbd5e1';
          b.style.background = '#f8fafc';
        });
        btn.style.border = '2px solid #0284c7';
        btn.style.background = '#f0f9ff';

        selectedNiche = btn.dataset.niche;
        const preset = nichePresets[selectedNiche];
        if (preset) {
          inputName.value = preset.name;
          inputSlogan.value = preset.slogan;
          selectedColor = preset.color;
          selectedAccent = preset.accent;
          selectedIcon = preset.icon;
          customColor.value = preset.color;
        }
      });
    });

    // Color Swatches
    document.querySelectorAll('.demo-color-choice').forEach((pill) => {
      pill.addEventListener('click', () => {
        selectedColor = pill.dataset.color;
        selectedAccent = pill.dataset.accent;
        customColor.value = selectedColor;
      });
    });

    customColor?.addEventListener('input', (e) => {
      selectedColor = e.target.value;
      selectedAccent = e.target.value;
    });

    // Submit Demo Request & Launch Rebranded Sandbox
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const brandName = inputName.value.trim() || 'Custom MLM Network';
      const slogan = inputSlogan.value.trim() || 'GLOBAL PARTNER NETWORK';

      const customBrand = {
        brandName,
        slogan,
        niche: selectedNiche,
        primaryColor: selectedColor,
        accentColor: selectedAccent,
        currencySymbol: currencySelect.value,
        iconClass: selectedIcon,
        demoExpiresAt: '2026-10-18T23:59:59Z'
      };

      // Save to localStorage
      localStorage.setItem('scale_tenant_brand', JSON.stringify(customBrand));

      // Attempt login with admin credentials provided
      const adminUser = document.querySelector('#demoAdminUser').value.trim();
      const adminPass = document.querySelector('#demoAdminPass').value.trim();

      fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: adminUser, password: adminPass, captcha: 'epWb' })
      })
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        if (data?.accessToken) {
          localStorage.setItem('vitality.accessToken', data.accessToken);
        }
        modal.style.display = 'none';
        window.location.href = 'dashboard.html';
      })
      .catch(() => {
        modal.style.display = 'none';
        window.location.href = 'login.html';
      });
    });
  </script>
