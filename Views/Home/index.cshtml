@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ScaleEngine &bull; Cloud MLM Software &amp; Automated Network Marketing SaaS</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <style>
    :root {
      --dark: #0f172a;
      --deep: #080a0d;
      --card-bg: #11151c;
      --card-border: #1e2633;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --accent-blue: #0284c7;
      --accent-green: #10b981;
      --purple: #8b5cf6;
      --gold: #f59e0b;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--text);
      background: var(--deep);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      line-height: 1.6;
    }

    /* Top Navigation */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(8, 10, 13, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--card-border);
      padding: 14px 0;
    }

    .nav-inner {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      color: #fff;
      text-decoration: none;
    }

    .brand-badge {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: linear-gradient(135deg, #0284c7, #0f172a);
      border: 1px solid #0284c7;
      color: #fff;
      font-size: 20px;
      box-shadow: 0 0 16px rgba(2, 132, 199, 0.35);
    }

    .brand-text strong { display: block; font-size: 18px; font-weight: 800; letter-spacing: -.02em; }
    .brand-text span { font-size: 9.5px; font-weight: 700; letter-spacing: .14em; color: var(--accent); text-transform: uppercase; }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      transition: color .15s;
    }

    .nav-links a:hover { color: #fff; }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .btn-login-nav {
      padding: 8px 18px;
      border: 1px solid var(--card-border);
      border-radius: 6px;
      color: #e2e8f0;
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 600;
      transition: all .15s;
    }
    .btn-login-nav:hover { background: rgba(255,255,255,.08); color: #fff; }

    .btn-demo-nav {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 20px;
      border-radius: 6px;
      background: linear-gradient(135deg, #0284c7, #38bdf8);
      color: #fff;
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 700;
      border: 0;
      cursor: pointer;
      transition: transform .15s, box-shadow .15s;
    }
    .btn-demo-nav:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(56,189,248,.3); color:#fff; }

    /* Hero Section */
    .hero {
      position: relative;
      padding: 90px 24px 80px;
      max-width: 1240px;
      margin: 0 auto;
      text-align: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 999px;
      background: rgba(56, 189, 248, 0.08);
      border: 1px solid rgba(56, 189, 248, 0.25);
      color: var(--accent);
      font-size: 12.5px;
      font-weight: 700;
      margin-bottom: 24px;
    }

    .hero h1 {
      font-size: 52px;
      font-weight: 900;
      letter-spacing: -.03em;
      line-height: 1.15;
      margin: 0 auto 20px;
      max-width: 960px;
      background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      font-size: 18px;
      color: var(--muted);
      max-width: 740px;
      margin: 0 auto 36px;
      line-height: 1.6;
    }

    .hero-ctas {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      margin-bottom: 50px;
      flex-wrap: wrap;
    }

    .btn-hero-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      height: 52px;
      padding: 0 32px;
      border-radius: 8px;
      background: linear-gradient(135deg, #0284c7, #38bdf8);
      color: #fff;
      text-decoration: none;
      font-size: 15px;
      font-weight: 700;
      border: 0;
      cursor: pointer;
      box-shadow: 0 8px 25px rgba(2, 132, 199, 0.35);
      transition: all .15s ease;
    }
    .btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(2, 132, 199, 0.5); color:#fff; }

    .btn-hero-secondary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      height: 52px;
      padding: 0 28px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      color: #f1f5f9;
      text-decoration: none;
      font-size: 15px;
      font-weight: 600;
      transition: all .15s ease;
    }
    .btn-hero-secondary:hover { background: rgba(255, 255, 255, 0.1); border-color: #475569; color: #fff; }

    /* Stats Grid */
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      max-width: 1040px;
      margin: 0 auto;
    }

    .stat-pill {
      border: 1px solid var(--card-border);
      border-radius: 12px;
      background: var(--card-bg);
      padding: 22px 18px;
      text-align: center;
    }

    .stat-pill strong { display: block; font-size: 26px; font-weight: 900; color: #fff; margin-bottom: 4px; }
    .stat-pill span { font-size: 12px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }

    /* Section Global */
    .section-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .section-head {
      text-align: center;
      margin-bottom: 50px;
    }

    .section-label {
      font-size: 11.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: var(--accent);
      margin-bottom: 8px;
      display: block;
    }

    .section-title {
      font-size: 34px;
      font-weight: 800;
      color: #fff;
      margin: 0 0 12px;
      letter-spacing: -.02em;
    }

    .section-desc {
      font-size: 15px;
      color: var(--muted);
      max-width: 640px;
      margin: 0 auto;
    }

    /* SaaS Architecture Feature Grid */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .feature-card {
      border: 1px solid var(--card-border);
      border-radius: 12px;
      background: var(--card-bg);
      padding: 30px 24px;
      display: flex;
      flex-direction: column;
      transition: transform .15s, border-color .15s;
    }
    .feature-card:hover { transform: translateY(-4px); border-color: #38bdf8; }

    .feature-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      background: #1e293b;
      color: var(--accent);
      display: grid;
      place-items: center;
      font-size: 22px;
      margin-bottom: 18px;
    }

    .feature-card h3 { font-size: 18px; font-weight: 700; color: #fff; margin: 0 0 8px; }
    .feature-card p { font-size: 13.5px; color: var(--muted); line-height: 1.5; margin: 0; }

    /* SaaS Subscription Pricing Grid */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      align-items: center;
    }

    .pricing-card {
      border: 1px solid var(--card-border);
      border-radius: 14px;
      background: var(--card-bg);
      padding: 36px 28px;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .pricing-card.featured {
      border-color: #0284c7;
      background: #0f172a;
      box-shadow: 0 0 35px rgba(2, 132, 199, 0.25);
      transform: scale(1.03);
    }

    .pricing-badge-top {
      position: absolute;
      top: -12px;
      right: 24px;
      background: linear-gradient(135deg, #0284c7, #38bdf8);
      color: #fff;
      font-size: 11px;
      font-weight: 800;
      padding: 3px 12px;
      border-radius: 999px;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .pricing-card h3 { font-size: 20px; font-weight: 800; color: #fff; margin: 0 0 4px; }
    .pricing-desc { font-size: 13px; color: var(--muted); margin: 0 0 20px; min-height: 38px; }

    .price-value { font-size: 38px; font-weight: 900; color: #fff; margin-bottom: 6px; }
    .price-value small { font-size: 14px; color: var(--muted); font-weight: 600; }

    .pricing-features {
      list-style: none;
      padding: 0;
      margin: 24px 0 30px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      font-size: 13.5px;
      color: #cbd5e1;
    }
    .pricing-features li { display: flex; align-items: center; gap: 8px; }
    .pricing-features li i { color: var(--accent-green); font-size: 16px; flex-shrink: 0; }

    .btn-pricing-plan {
      width: 100%;
      height: 48px;
      border-radius: 8px;
      background: #1e293b;
      color: #fff;
      border: 1px solid #334155;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all .15s ease;
    }
    .btn-pricing-plan:hover { background: #fff; color: #0f172a; }
    .pricing-card.featured .btn-pricing-plan {
      background: linear-gradient(135deg, #0284c7, #38bdf8);
      border: 0;
      box-shadow: 0 4px 16px rgba(2, 132, 199, 0.4);
    }
    .pricing-card.featured .btn-pricing-plan:hover { filter: brightness(1.1); color: #fff; }

    /* Footer */
    footer {
      border-top: 1px solid var(--card-border);
      background: #080a0d;
      padding: 60px 24px 30px;
    }

    .footer-inner {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }

    .footer-col h4 { font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #fff; margin-bottom: 16px; }
    .footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
    .footer-col ul a { color: var(--muted); text-decoration: none; font-size: 13px; }
    .footer-col ul a:hover { color: #fff; }

    .footer-bottom {
      max-width: 1240px;
      margin: 0 auto;
      padding-top: 24px;
      border-top: 1px solid var(--card-border);
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: 12px;
    }

    @@media (max-width: 980px) {
      .features-grid, .pricing-grid { grid-template-columns: 1fr; }
      .hero h1 { font-size: 36px; }
      .hero-stats { grid-template-columns: repeat(2, 1fr); }
      .footer-inner { grid-template-columns: 1fr; }
      .nav-links { display: none; }
      .pricing-card.featured { transform: none; }
    }
  </style>
</head>
<body>

  <!-- Navigation -->
  <header class="site-nav">
    <div class="nav-inner">
      <a class="brand-logo" href="/">
        <div class="brand-badge"><i class="bi bi-cpu-fill"></i></div>
        <div class="brand-text">
          <strong>ScaleEngine</strong>
          <span>MLM SAAS PLATFORM</span>
        </div>
      </a>

      <nav class="nav-links">
        <a href="#features">Architecture</a>
        <a href="#pricing">SaaS Subscriptions</a>
        <a href="#faq">FAQ</a>
        <a href="support.html">Contact Us</a>
      </nav>

      <div class="nav-actions">
        <button class="btn-demo-nav" id="topRequestDemoBtn" type="button"><i class="bi bi-rocket-takeoff-fill"></i> Request 30-Day Demo</button>
        <a class="btn-login-nav" href="login.html"><i class="bi bi-box-arrow-in-right"></i> Sign In</a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <main>
    <section class="hero" id="home">
      <div class="hero-badge"><i class="bi bi-clouds-fill"></i> Next-Gen Multi-Tenant MLM Cloud Engine</div>
      <h1>Launch &amp; Scale Your Own Multi-Level Marketing Company</h1>
      <p>ScaleEngine is the all-in-one White-Label MLM SaaS platform. Automate matrix &amp; binary compensation plans, real-time commission payouts, downline trees, PayFast gateways, and AI-powered partner coaching.</p>

      <div class="hero-ctas">
        <button class="btn-hero-primary" id="heroRequestDemoBtn" type="button">
          <i class="bi bi-rocket-takeoff-fill"></i> Request 30-Day Free Demo Sandbox
        </button>
        <a class="btn-hero-secondary" href="#features">
          <i class="bi bi-cpu-fill" style="color:#38bdf8;"></i> Explore SaaS Architecture
        </a>
      </div>

      <div class="hero-stats">
        <div class="stat-pill">
          <strong>100% White-Label</strong>
          <span>Your Brand, Logo &amp; Colors</span>
        </div>
        <div class="stat-pill">
          <strong>7-Level Matrix</strong>
          <span>Real-Time Commission Math</span>
        </div>
        <div class="stat-pill">
          <strong>Built-In AI</strong>
          <span>GPT-4o Partner Copilot</span>
        </div>
        <div class="stat-pill">
          <strong>30 Days Free</strong>
          <span>Instant Sandboxed Tenant</span>
        </div>
      </div>
    </section>

    <!-- SaaS Features & Architecture -->
    <section id="features" style="border-top: 1px solid var(--card-border); background: #0c0f14;">
      <div class="section-container">
        <div class="section-head">
          <span class="section-label">Enterprise Architecture</span>
          <h2 class="section-title">Everything You Need to Run a Global MLM</h2>
          <p class="section-desc">From complex qualification rules to automated SARS tax invoices and PayFast payments, ScaleEngine handles the complete backoffice infrastructure.</p>
        </div>

        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon-box"><i class="bi bi-diagram-3-fill"></i></div>
            <h3>Dynamic Compensation Engine</h3>
            <p>Configure direct sponsor bonuses, unilevel overrides (up to 7 levels), leadership salaries, rank advancement incentives, and auto-ship qualification rules with zero code.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon-box"><i class="bi bi-palette-fill"></i></div>
            <h3>Instant Multi-Tenant Rebranding</h3>
            <p>White-label every aspect of the portal. Set your company name, custom HEX palette, currency symbols, starter kit products, and domain with a single click.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon-box"><i class="bi bi-robot"></i></div>
            <h3>AI Partner Copilot (GPT-4o)</h3>
            <p>Every partner gets a 24/7 AI business mentor grounded in their live downline stats, sales turnover, qualification gap analysis, and WhatsApp prospecting scripts.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon-box"><i class="bi bi-credit-card-2-front-fill"></i></div>
            <h3>South African &amp; Global Gateways</h3>
            <p>Built-in integration for PayFast, Credit/Debit Cards, Instant EFT, Capitec Pay, SnapScan, and internal E-Wallet peer-to-peer settlement.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon-box"><i class="bi bi-file-earmark-check-fill"></i></div>
            <h3>FICA, KYC &amp; Tax Compliance</h3>
            <p>Document verification portal for partner identity checks, SARS-compliant automated tax invoices, and printable leadership salary payslips.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon-box"><i class="bi bi-chat-left-text-fill"></i></div>
            <h3>Internal Messaging &amp; Blue Tickets</h3>
            <p>Built-in partner mailbox with read/verified blue ticket tracking, real-time team chat channels, and automated push notification counters.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SaaS Subscription Pricing -->
    <section id="pricing">
      <div class="section-container">
        <div class="section-head">
          <span class="section-label">Flexible SaaS Licensing</span>
          <h2 class="section-title">Transparent Monthly Subscriptions</h2>
          <p class="section-desc">Start with our 30-day free sandbox demo, then choose the plan that matches your network distributor volume.</p>
        </div>

        <div class="pricing-grid">
          <!-- Starter Plan -->
          <div class="pricing-card">
            <h3>Starter MLM</h3>
            <p class="pricing-desc">For emerging network marketing startups and direct sales brands.</p>
            <div class="price-value">R 1,499 <small>/ month</small></div>
            <ul class="pricing-features">
              <li><i class="bi bi-check-circle-fill"></i> Up to 500 Active Members</li>
              <li><i class="bi bi-check-circle-fill"></i> 5-Level Compensation Plan</li>
              <li><i class="bi bi-check-circle-fill"></i> PayFast &amp; Card Gateway</li>
              <li><i class="bi bi-check-circle-fill"></i> Custom Brand &amp; Colors</li>
              <li><i class="bi bi-check-circle-fill"></i> E-Wallet &amp; Direct Withdrawals</li>
              <li><i class="bi bi-check-circle-fill"></i> Standard Email Support</li>
            </ul>
            <button type="button" class="btn-pricing-plan" onclick="window.openRequestDemoModal('Starter Plan')">Request 30-Day Demo</button>
          </div>

          <!-- Growth / Pro Plan -->
          <div class="pricing-card featured">
            <span class="pricing-badge-top">Most Popular</span>
            <h3>Scale Pro</h3>
            <p class="pricing-desc">For established MLM companies scaling across South Africa and Africa.</p>
            <div class="price-value">R 3,999 <small>/ month</small></div>
            <ul class="pricing-features">
              <li><i class="bi bi-check-circle-fill"></i> Up to 5,000 Active Members</li>
              <li><i class="bi bi-check-circle-fill"></i> 7-Level Matrix &amp; Binary Plans</li>
              <li><i class="bi bi-check-circle-fill"></i> GPT-4o AI Partner Copilot</li>
              <li><i class="bi bi-check-circle-fill"></i> Custom Domain (e.g. yourbrand.com)</li>
              <li><i class="bi bi-check-circle-fill"></i> Auto-Ship Subscriptions Engine</li>
              <li><i class="bi bi-check-circle-fill"></i> FICA / KYC Document Portal</li>
              <li><i class="bi bi-check-circle-fill"></i> Priority 24/7 WhatsApp Support</li>
            </ul>
            <button type="button" class="btn-pricing-plan" onclick="window.openRequestDemoModal('Scale Pro Plan')">Launch 30-Day Trial</button>
          </div>

          <!-- Enterprise Plan -->
          <div class="pricing-card">
            <h3>Enterprise Global</h3>
            <p class="pricing-desc">For high-volume international multi-tier organizations.</p>
            <div class="price-value">R 8,999 <small>/ month</small></div>
            <ul class="pricing-features">
              <li><i class="bi bi-check-circle-fill"></i> Unlimited Members &amp; Transactions</li>
              <li><i class="bi bi-check-circle-fill"></i> Custom Rank &amp; Incentive Engine</li>
              <li><i class="bi bi-check-circle-fill"></i> Multi-Currency (ZAR, USD, NGN, EUR)</li>
              <li><i class="bi bi-check-circle-fill"></i> Dedicated Cloud Database Instance</li>
              <li><i class="bi bi-check-circle-fill"></i> Custom API Webhooks &amp; ERP Sync</li>
              <li><i class="bi bi-check-circle-fill"></i> Dedicated Account Manager &amp; SLA</li>
            </ul>
            <button type="button" class="btn-pricing-plan" onclick="window.openRequestDemoModal('Enterprise Plan')">Contact Enterprise Sales</button>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" style="border-top: 1px solid var(--card-border); background: #0c0f14;">
      <div class="section-container">
        <div class="section-head">
          <span class="section-label">Common Questions</span>
          <h2 class="section-title">Frequently Asked Questions</h2>
        </div>

        <div style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px;">
          <div style="padding: 22px 26px; border: 1px solid var(--card-border); border-radius: 10px; background: var(--card-bg);">
            <h4 style="margin:0 0 8px; font-size:16px; color:#fff;">How does the 30-Day Free Demo Sandbox work?</h4>
            <p style="margin:0; font-size:13.5px; color:var(--muted); line-height:1.5;">When you request a demo, you answer a few quick questions (company name, industry, preferred color theme, and test admin credentials). Our engine automatically rebrands the entire platform, seeds sample downlines and store products, and gives you full administrative access for 30 days.</p>
          </div>

          <div style="padding: 22px 26px; border: 1px solid var(--card-border); border-radius: 10px; background: var(--card-bg);">
            <h4 style="margin:0 0 8px; font-size:16px; color:#fff;">Can I customize the compensation plan rules?</h4>
            <p style="margin:0; font-size:13.5px; color:var(--muted); line-height:1.5;">Yes. The compensation engine calculates multi-tier overrides, direct bonuses, maturity hold periods (e.g. 7-day commission vesting), and monthly leadership qualification salaries according to your business rules.</p>
          </div>

          <div style="padding: 22px 26px; border: 1px solid var(--card-border); border-radius: 10px; background: var(--card-bg);">
            <h4 style="margin:0 0 8px; font-size:16px; color:#fff;">What payment gateways are supported?</h4>
            <p style="margin:0; font-size:13.5px; color:var(--muted); line-height:1.5;">ScaleEngine supports PayFast for South African credit/debit cards, Instant EFT, Capitec Pay, SnapScan, and peer-to-peer wallet balances, as well as Stripe and PayPal for international payments.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- 30-Day Demo Request & Rebrand Modal -->
  <div class="scale-modal-backdrop" id="requestDemoModal" aria-hidden="true" style="display:none; position:fixed; inset:0; z-index:999999; background:rgba(8,10,13,0.8); backdrop-filter:blur(6px); justify-content:center; align-items:center; padding:16px;">
