@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Register New Member";
}

<section class="panel">
  <div class="panel-head">
    <div class="panel-icon"><i class="bi bi-person-plus-fill"></i></div>
    <div>
      <h1>Register New Team Member</h1>
      <p class="subtitle">Add a new partner directly under your sponsorship tree hierarchy.</p>
    </div>
  </div>

  <form id="memberForm" novalidate>
    <h2 class="section-title"><i class="bi bi-person-badge"></i> Account Credentials</h2>
    <div class="grid">
      <div class="field">
        <label for="username">Create Username <span>*</span></label>
        <input id="username" required placeholder="e.g. partner_john">
      </div>
      <div class="field">
        <label for="sponsor">Sponsor User ID <span>*</span></label>
        <input id="sponsor" value="samkelisojam" readonly required>
      </div>
      <div class="field">
        <label for="firstName">First Name <span>*</span></label>
        <input id="firstName" required placeholder="First name">
      </div>
      <div class="field">
        <label for="surname">Surname <span>*</span></label>
        <input id="surname" required placeholder="Surname">
      </div>
      <div class="field">
        <label for="email">E-mail Address <span>*</span></label>
        <input id="email" type="email" required placeholder="name@example.com">
      </div>
      <div class="field">
        <label for="country">Country <span>*</span></label>
        <select id="country" required>
          <option value="">Select country</option>
          <option selected>South Africa</option><option>Botswana</option><option>Lesotho</option><option>Namibia</option><option>Eswatini</option><option>Zimbabwe</option><option>Zambia</option><option>Mozambique</option><option>Other</option>
        </select>
      </div>
      <div class="field">
        <label for="mobile">Mobile Number <span>*</span></label>
        <input id="mobile" type="tel" required placeholder="e.g. 0768322222">
      </div>
      <div class="field"></div>
      <div class="field">
        <label for="password">Password <span>*</span></label>
        <input id="password" type="password" minlength="8" required placeholder="At least 8 characters">
      </div>
      <div class="field">
        <label for="confirm">Confirm Password <span>*</span></label>
        <input id="confirm" type="password" required placeholder="Repeat password">
      </div>
    </div>

    <label class="agreement">
      <input id="terms" type="checkbox" required>
      <span>By clicking register you agree to the <a href="rules.html" target="_blank">ScaleEngine Partner Terms &amp; Policies</a>.</span>
    </label>

    <button type="submit" id="submitBtn"><i class="bi bi-person-check-fill"></i> Register New Member</button>
    <p class="status" id="status" role="status" aria-live="polite"></p>
  </form>
</section>

@section Styles {
<style>
  :root { --dark: #0f172a; --deep: #0d0f12; --ink: #1e293b; --muted: #64748b; --line: #e2e8f0; --paper: #fff; --bg: #f8fafc; --success: #16a34a; --danger: #dc2626; }
  * { box-sizing: border-box; }
  
  .panel { padding: 30px 36px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); box-shadow: 0 4px 18px rgba(0, 0, 0, .04); max-width: 820px; margin: 0 auto; }
  .panel-head { display: flex; align-items: center; gap: 16px; margin-bottom: 24px; }
  .panel-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 10px; background: #0f172a; color: #fff; font-size: 22px; flex-shrink: 0; }
  h1 { margin: 0 0 4px; font-size: 20px; font-weight: 700; color: var(--dark); }
  .subtitle { margin: 0; color: var(--muted); font-size: 13.5px; }

  .section-title { font-size: 13.5px; font-weight: 700; color: var(--dark); text-transform: uppercase; letter-spacing: .04em; margin: 0 0 16px; display: flex; align-items: center; gap: 8px; }
  .section-title i { color: #64748b; }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  label { font-size: 13px; font-weight: 600; color: #334155; }
  label span { color: var(--danger); }
  
  input, select { width: 100%; height: 44px; padding: 0 13px; border: 1px solid var(--line); border-radius: 6px; color: var(--ink); background: #fdfdfd; font: 14px -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; outline: none; transition: border-color .15s, box-shadow .15s; }
  input:focus, select:focus { border-color: var(--dark); box-shadow: 0 0 0 3px rgba(15, 23, 42, .1); background: #fff; }
  input[readonly] { color: #64748b; background: #f1f5f9; cursor: not-allowed; }

  .agreement { display: flex; align-items: center; gap: 10px; margin: 24px 0 20px; color: #475569; font-size: 13px; cursor: pointer; }
  .agreement input { width: 16px; height: 16px; margin: 0; accent-color: var(--dark); cursor: pointer; }
  .agreement a { color: var(--dark); font-weight: 600; text-decoration: underline; }

  button[type="submit"] { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; height: 48px; border: 0; border-radius: 6px; color: white; background: var(--dark); cursor: pointer; font-size: 14.5px; font-weight: 700; letter-spacing: .02em; transition: background .15s, transform .15s; }
  button[type="submit"]:hover { background: #000; transform: translateY(-1px); }
  button[type="submit"]:disabled { cursor: wait; opacity: .65; transform: none; }

  .status { min-height: 20px; margin: 14px 0 0; text-align: center; font-size: 13px; font-weight: 600; color: var(--success); }
  .status.error { color: var(--danger); }

  @@media (max-width: 650px) {
    .panel { padding: 22px 18px; }
    .grid { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
}

@section Scripts {
<script>
  const token = localStorage.getItem('vitality.accessToken');
  const form = document.querySelector('#memberForm');
  const status = document.querySelector('#status');
  const sponsorInput = document.querySelector('#sponsor');

  if (token) {
    fetch('/api/profile', { headers: { Authorization: `Bearer ${token}` } })
      .then((r) => r.ok ? r.json() : null)
      .then((profile) => {
        if (profile?.username) sponsorInput.value = profile.username;
      })
      .catch(() => {});
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    status.className = 'status';
    status.textContent = '';
    if (!form.checkValidity()) { form.reportValidity(); return; }

    const pwd = document.querySelector('#password').value;
    const confirmPwd = document.querySelector('#confirm').value;
    if (pwd !== confirmPwd) {
      status.className = 'status error';
      status.textContent = 'Passwords do not match.';
      return;
    }

    const btn = document.querySelector('#submitBtn');
    btn.disabled = true;
    status.textContent = 'Submitting registration...';

    try {
      const response = await fetch('/api/members', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token || ''}`
        },
        body: JSON.stringify({
          username: document.querySelector('#username').value,
          firstName: document.querySelector('#firstName').value,
          lastName: document.querySelector('#surname').value,
          email: document.querySelector('#email').value,
          country: document.querySelector('#country').value,
          mobile: document.querySelector('#mobile').value,
          password: pwd,
          confirmPassword: confirmPwd
        })
      });

      const result = await response.json();
      if (response.ok) {
        status.className = 'status';
        status.textContent = 'Member registered successfully! Redirecting to your member list...';
        form.reset();
        setTimeout(() => {
          window.location.href = 'my-referrals.html';
        }, 800);
      } else {
        status.className = 'status error';
        status.textContent = result.message || Object.values(result.errors || {}).flat().join(' ') || 'Unable to register this member.';
      }
    } catch {
      status.className = 'status error';
      status.textContent = 'Unable to contact the server.';
    } finally {
      btn.disabled = false;
    }
  });
</script>
}


