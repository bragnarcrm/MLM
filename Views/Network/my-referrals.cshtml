@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Referrals";
}

<section class="panel">
  <div class="panel-head">
    <div>
      <h1><i class="bi bi-people-fill"></i> My Referrals</h1>
      <p class="subtitle">Direct and indirect downline team partners sponsored by your account.</p>
    </div>
    <a href="add-member.html" class="btn-add-partner"><i class="bi bi-person-plus-fill"></i> Register New Member</a>
  </div>

  <div class="import-row">
    <label for="csvFile"><i class="bi bi-file-earmark-spreadsheet"></i> Bulk import (CSV: username, fullName, mobile)</label>
    <input type="file" id="csvFile" accept=".csv,text/csv">
    <button type="button" id="importBtn">Import CSV</button>
    <span id="importStatus"></span>
  </div>

  <div class="toolbar">
    <label>Show <select id="entries"><option>10</option><option>25</option><option>50</option><option>100</option></select> entries</label>
    <label>Search: <input id="search" placeholder="Search by name, ID, rank..."></label>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>SL No.</th>
          <th>User ID</th>
          <th>Full Name</th>
          <th>Phone</th>
          <th>Referral ID</th>
          <th>Rank</th>
          <th>Monthly Sales</th>
          <th>Joining Fee Paid</th>
          <th>Join Date</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody id="rows">
        <tr><td class="empty" colspan="10" id="empty">No data available in table</td></tr>
      </tbody>
    </table>
  </div>

  <div class="table-footer">
    <span id="count">Showing 0 to 0 of 0 entries</span>
    <span class="pager">
      <button type="button" id="prevPage">Previous</button>
      <button type="button" id="nextPage">Next</button>
    </span>
  </div>
</section>

<!-- Custom Styled Confirmation Modal -->
<div class="scale-modal-backdrop" id="deleteConfirmModal" aria-hidden="true">
  <div class="scale-modal-dialog delete-dialog">
    <div class="modal-body-confirm">
      <div class="delete-icon-box"><i class="bi bi-exclamation-triangle-fill"></i></div>
      <h2>Remove Team Member?</h2>
      <p class="confirm-desc">Are you sure you want to remove <strong id="deleteTargetName">this member</strong> (<code id="deleteTargetId">username</code>)?</p>
      <p class="confirm-subdesc">This action removes the partner from your active downline list and cannot be undone.</p>
    </div>
    <div class="modal-footer-confirm">
      <button type="button" class="btn-modal-cancel" id="cancelDeleteBtn">Cancel</button>
      <button type="button" class="btn-modal-danger" id="confirmDeleteBtn"><i class="bi bi-trash3-fill"></i> Yes, Remove Member</button>
    </div>
  </div>
</div>

@section Styles {
<style>
  :root { --dark: #0f172a; --deep: #0d0f12; --ink: #1e293b; --muted: #64748b; --paper: #fff; --bg: #f8fafc; --line: #e2e8f0; --danger: #dc2626; --success: #16a34a; }
  * { box-sizing: border-box; }

  .panel { padding: 30px 32px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); box-shadow: 0 4px 18px rgba(0,0,0,.04); }
  .panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px; flex-wrap: wrap; gap: 14px; }
  h1 { margin: 0 0 4px; font-size: 21px; font-weight: 700; color: var(--dark); display: flex; align-items: center; gap: 8px; }
  .subtitle { margin: 0; color: var(--muted); font-size: 13.5px; }

  .btn-add-partner { display: inline-flex; align-items: center; gap: 7px; height: 40px; padding: 0 18px; border-radius: 6px; background: var(--dark); color: #fff; text-decoration: none; font-size: 13px; font-weight: 700; }
  .btn-add-partner:hover { background: #000; color: #fff; }

  .import-row { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; padding: 14px 16px; border: 1px dashed var(--line); border-radius: 8px; background: #f8fafc; color: var(--muted); font-size: 12.5px; flex-wrap: wrap; }
  .import-row button { height: 34px; padding: 0 16px; border: 0; border-radius: 5px; color: #fff; background: var(--dark); cursor: pointer; font-size: 12px; font-weight: 600; }
  .import-row button:hover { background: #000; }
  .import-row #importStatus { color: var(--success); font-weight: 600; }

  .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 14px; color: var(--muted); font-size: 12.5px; }
  .toolbar label { display: flex; align-items: center; gap: 7px; }
  select, input { height: 38px; padding: 0 12px; border: 1px solid var(--line); border-radius: 6px; color: var(--ink); background: var(--paper); font-size: 13px; outline: none; }
  input { width: 220px; }
  input:focus { border-color: var(--dark); }

  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
  table { width: 100%; min-width: 920px; border-collapse: collapse; font-size: 13px; }
  th, td { padding: 13px 12px; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
  th { color: var(--muted); background: #f8fafc; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  tbody tr:hover { background: #f8fafc; }
  td.empty { padding: 32px; color: var(--muted); text-align: center; }

  .actions { text-align: right; }
  .actions button { height: 30px; margin-left: 4px; padding: 0 10px; border: 1px solid var(--line); border-radius: 5px; color: var(--ink); background: #fff; cursor: pointer; font-size: 12px; font-weight: 600; transition: all .12s; }
  .actions button:hover { background: #f1f5f9; }
  .actions .delete-btn { color: var(--danger); border-color: #fecaca; background: #fff; }
  .actions .delete-btn:hover { background: #fee2e2; }
  .actions input { height: 30px; width: 110px; padding: 2px 8px; font-size: 12px; }

  .table-footer { display: flex; justify-content: space-between; margin-top: 14px; color: var(--muted); font-size: 12px; }
  .pager { display: flex; gap: 14px; }
  .pager button { border: 0; color: var(--muted); background: transparent; cursor: pointer; }
  .pager button:disabled { opacity: .4; cursor: not-allowed; }

  /* Custom Confirmation Modal */
  .scale-modal-backdrop { position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; height: 100vh !important; background: rgba(15, 23, 42, .7); display: none; justify-content: center; align-items: center; z-index: 999999 !important; padding: 20px; }
  .scale-modal-backdrop.is-open { display: flex !important; }
  
  .delete-dialog { position: relative !important; z-index: 1000000 !important; width: 100%; max-width: 440px; margin: auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, .35); border: 1px solid var(--line); }
  .modal-body-confirm { padding: 28px 24px 20px; text-align: center; }
  .delete-icon-box { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; background: #fee2e2; color: #dc2626; font-size: 26px; margin: 0 auto 16px; }
  .delete-dialog h2 { margin: 0 0 8px; font-size: 18px; font-weight: 700; color: var(--dark); }
  .confirm-desc { margin: 0 0 6px; font-size: 13.5px; color: #334155; }
  .confirm-subdesc { margin: 0; font-size: 12px; color: var(--muted); }

  .modal-footer-confirm { display: flex; gap: 10px; padding: 16px 24px; border-top: 1px solid var(--line); background: #f8fafc; }
  .btn-modal-cancel { flex: 1; height: 40px; border: 1px solid var(--line); border-radius: 6px; background: #fff; color: #475569; font-size: 13px; font-weight: 600; cursor: pointer; }
  .btn-modal-cancel:hover { background: #f1f5f9; }
  .btn-modal-danger { flex: 1.2; height: 40px; border: 0; border-radius: 6px; background: #dc2626; color: #fff; font-size: 13px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .btn-modal-danger:hover { background: #b91c1c; }
</style>
}

@section Scripts {
<script src="/js/portal-table.js"></script>
<script>
(() => {
  const tableBody = document.querySelector('#rows');
  const authHeaders = () => ({ Authorization: `Bearer ${localStorage.getItem('vitality.accessToken') || ''}` });

  const deleteModal = document.querySelector('#deleteConfirmModal');
  const deleteTargetName = document.querySelector('#deleteTargetName');
  const deleteTargetId = document.querySelector('#deleteTargetId');
  const cancelDeleteBtn = document.querySelector('#cancelDeleteBtn');
  const confirmDeleteBtn = document.querySelector('#confirmDeleteBtn');
  let pendingDeleteId = null;

  if (deleteModal && deleteModal.parentElement !== document.body) {
    document.body.appendChild(deleteModal);
  }

  const openDeleteModal = (id, username, name) => {
    pendingDeleteId = id;
    deleteTargetName.textContent = name || 'this member';
    deleteTargetId.textContent = username || `ID: ${id}`;
    deleteModal.classList.add('is-open');
    deleteModal.setAttribute('aria-hidden', 'false');
  };

  const closeDeleteModal = () => {
    deleteModal.classList.remove('is-open');
    deleteModal.setAttribute('aria-hidden', 'true');
    pendingDeleteId = null;
  };

  cancelDeleteBtn.addEventListener('click', closeDeleteModal);
  deleteModal.addEventListener('click', (e) => { if (e.target === deleteModal) closeDeleteModal(); });

  confirmDeleteBtn.addEventListener('click', async () => {
    if (!pendingDeleteId) return;
    confirmDeleteBtn.disabled = true;
    try {
      const response = await fetch(`/api/members/${pendingDeleteId}`, { method: 'DELETE', headers: authHeaders() });
      if (response.ok) {
        table.refresh(table.getItems().filter((item) => String(item.id) !== String(pendingDeleteId)));
      }
    } catch { }
    finally {
      confirmDeleteBtn.disabled = false;
      closeDeleteModal();
    }
  });

  const renderRow = (referral, index) => `<tr data-id="${referral.id}" data-userid="${referral.userId}" data-name="${referral.fullName}">
      <td>${index + 1}</td>
      <td><code>${referral.userId}</code></td>
      <td><strong>${referral.fullName}</strong></td>
      <td>${referral.mobile}</td>
      <td data-field="sponsor">${referral.sponsorId}</td>
      <td data-field="rank"><span class="badge-rank">${referral.rank}</span></td>
      <td data-field="monthlySales"><strong>R ${Number(referral.monthlySales).toFixed(2)}</strong></td>
      <td>${referral.status === 'Active' ? '<span class="text-success font-weight-bold">Yes</span>' : '<span class="text-muted">No</span>'}</td>
      <td style="color:var(--muted); font-size:12px;">${referral.joinedOn}</td>
      <td class="actions">
        <button type="button" class="edit-btn" data-action="edit">Edit</button>
        <button type="button" data-action="reassign">Reassign</button>
        <button type="button" class="delete-btn" data-action="delete"><i class="bi bi-trash3"></i> Delete</button>
      </td>
    </tr>`;

  const table = initPortalTable({
    url: '/api/network/referrals?page=1&pageSize=100',
    tbody: tableBody,
    countEl: document.querySelector('#count'),
    searchEl: document.querySelector('#search'),
    entriesEl: document.querySelector('#entries'),
    prevBtn: document.querySelector('#prevPage'),
    nextBtn: document.querySelector('#nextPage'),
    columnCount: 10,
    renderRow,
    matches: (referral, term) => `${referral.userId} ${referral.fullName} ${referral.sponsorId} ${referral.status}`.toLowerCase().includes(term),
    emptyMessage: 'No data available in table',
    searchMessage: 'No matching referrals',
    errorMessage: 'Unable to load referrals.'
  });

  tableBody.addEventListener('click', async (event) => {
    const button = event.target.closest('button[data-action]');
    if (!button) return;
    const row = button.closest('tr');
    const id = row.dataset.id;
    const username = row.dataset.userid;
    const name = row.dataset.name;

    if (button.dataset.action === 'delete') {
      openDeleteModal(id, username, name);
      return;
    }

    if (button.dataset.action === 'reassign') {
      const sponsorCell = row.querySelector('[data-field="sponsor"]');
      const currentSponsor = sponsorCell.textContent;
      sponsorCell.innerHTML = `<input type="text" class="edit-sponsor" value="${currentSponsor}" placeholder="New sponsor User ID">`;
      row.querySelector('.actions').innerHTML = `<button type="button" data-action="save-reassign">Save</button> <button type="button" data-action="cancel">Cancel</button>`;
      return;
    }

    if (button.dataset.action === 'save-reassign') {
      const newSponsorId = row.querySelector('.edit-sponsor').value.trim();
      if (!newSponsorId) return;
      const response = await fetch(`/api/network/referrals/${encodeURIComponent(row.dataset.userid)}/reassign`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', ...authHeaders() },
        body: JSON.stringify({ newSponsorId })
      });
      const result = await response.json();
      if (response.ok) {
        table.refresh(table.getItems().filter((item) => String(item.id) !== id));
      } else {
        row.querySelector('[data-field="sponsor"]').innerHTML = `<span class="field-error">${result.message || 'Could not reassign that member.'}</span>`;
      }
      return;
    }

    if (button.dataset.action === 'edit') {
      const rankCell = row.querySelector('[data-field="rank"]');
      const salesCell = row.querySelector('[data-field="monthlySales"]');
      const currentRank = rankCell.textContent;
      const currentSales = salesCell.textContent.replace(/[^0-9.]/g, '');
      rankCell.innerHTML = `<input type="text" class="edit-rank" value="${currentRank}">`;
      salesCell.innerHTML = `<input type="number" step="0.01" class="edit-sales" value="${currentSales}">`;
      row.querySelector('.actions').innerHTML = `<button type="button" data-action="save">Save</button> <button type="button" data-action="cancel">Cancel</button>`;
      return;
    }

    if (button.dataset.action === 'cancel') {
      table.render();
      return;
    }

    if (button.dataset.action === 'save') {
      const item = table.getItems().find((referral) => String(referral.id) === id);
      const rank = row.querySelector('.edit-rank').value;
      const monthlySales = Number(row.querySelector('.edit-sales').value) || 0;
      const response = await fetch(`/api/members/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', ...authHeaders() },
        body: JSON.stringify({ fullName: item.fullName, mobile: item.mobile, rank, monthlySales, status: item.status })
      });
      if (response.ok) {
        item.rank = rank;
        item.monthlySales = monthlySales;
        table.render();
      }
    }
  });

  // CSV Bulk Import
  document.querySelector('#importBtn').addEventListener('click', async () => {
    const fileInput = document.querySelector('#csvFile');
    const status = document.querySelector('#importStatus');
    if (!fileInput.files || !fileInput.files[0]) {
      status.textContent = 'Please select a CSV file first.';
      return;
    }
    const text = await fileInput.files[0].text();
    const lines = text.split(/\r?\n/).filter(Boolean);
    let count = 0;
    for (const line of lines) {
      const [username, fullName, mobile] = line.split(',');
      if (username && fullName) {
        await fetch('/api/members', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...authHeaders() },
          body: JSON.stringify({
            username: username.trim(),
            firstName: fullName.trim().split(' ')[0] || username.trim(),
            lastName: fullName.trim().split(' ').slice(1).join(' ') || 'Partner',
            email: `${username.trim()}@@example.com`,
            country: 'South Africa',
            mobile: (mobile || '0820000000').trim(),
            password: 'Password@123',
            confirmPassword: 'Password@123'
          })
        });
        count++;
      }
    }
    status.textContent = `Imported ${count} members successfully.`;
    window.location.reload();
  });
})();
</script>
}


