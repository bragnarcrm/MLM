@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Tree View";
}

<section class="panel"><h1>Team Structure</h1><form class="lookup" id="lookup"><label for="userId">Enter User ID <span>*</span><input id="userId" placeholder="Enter User ID" required></label><button type="submit"><i class="bi bi-search"></i> Submit</button><button class="reset" type="button" id="reset"><i class="bi bi-arrow-counterclockwise"></i> Reset</button></form><h2 class="tree-title">Tree View</h2><div class="legend"><span><i class="dot"></i> Active</span><span><i class="dot inactive"></i> Inactive</span><span><i class="dot vacant"></i> Vacant</span></div><div class="tree" id="tree"></div><p class="empty-state" id="empty">No team found for this User ID.</p></section>

<section class="panel"><h2 class="tree-title" style="margin-top:0"><i class="bi bi-search"></i> Genealogy Search</h2><p class="section-hint">Search your whole downline by name or User ID &mdash; not just direct referrals.</p><form class="lookup" id="searchForm"><label for="query">Name or User ID<input id="query" placeholder="e.g. demo-member-03"></label><button type="submit"><i class="bi bi-search"></i> Search</button></form><div class="table-wrap"><table class="results-table"><thead><tr><th>Level</th><th>User ID</th><th>Full Name</th><th>Sponsor</th><th>Status</th><th>Rank</th></tr></thead><tbody id="searchRows"><tr><td colspan="6" class="empty-row">Enter a name or User ID above to search your whole team.</td></tr></tbody></table></div></section>

<section class="panel"><h2 class="tree-title" style="margin-top:0"><i class="bi bi-bar-chart-line"></i> Team Performance</h2><div class="perf-summary" id="perfSummary"></div><div class="table-wrap"><table class="results-table"><thead><tr><th>Level</th><th>Members</th><th>Active</th><th>Inactive</th><th>Team Sales(R)</th></tr></thead><tbody id="perfRows"><tr><td colspan="5" class="empty-row">Loading...</td></tr></tbody></table></div></section>

@section Styles {
<style>
:root { --green: #24272b; --deep: #14161a; --ink: #27372f; --muted: #7b857e; --paper: #fff; --bg: #f4f7f4; --line: #dce6de; --active: #56a45b; --inactive: #d66b61; --vacant: #b9c5bc; }
    * { box-sizing: border-box; } body { margin: 0; color: var(--ink); background: var(--bg); font-family: 'Segoe UI', Tahoma, sans-serif; }
    .sidebar { position: fixed; inset: 0 auto 0 0; z-index: 2; width: 248px; padding: 22px 14px; color: #dce9de; background: var(--deep); }
    .brand { display: flex; align-items: center; gap: 11px; padding: 8px 10px 27px; color: white; font: italic 700 25px Georgia, serif; } .leaf { width: 28px; height: 35px; border-radius: 100% 0 100% 0; background: #3a3f45; transform: rotate(-25deg); }
    nav a, .nav-label { display: flex; align-items: center; gap: 12px; min-height: 40px; padding: 0 12px; border-radius: 5px; color: inherit; text-decoration: none; font-size: 13px; } nav a:hover, nav a.active { color: white; background: rgba(255,255,255,.13); } .icon { width: 19px; text-align: center; font-size: 16px; } .nav-label { min-height: 30px; margin-top: 12px; color: #8daf98; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .top { min-height: 68px; margin-left: 248px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; color: white; background: var(--deep); } .top a { color: #d8e9da; font-size: 13px; text-decoration: none; }
    main { width: min(calc(100% - 280px), 1080px); margin: 28px auto 50px; } .panel { padding: 25px 30px 35px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper); box-shadow: 0 8px 24px rgba(30, 59, 39, .06); } h1 { margin: 0 0 23px; font-size: 21px; } .lookup { display: flex; align-items: end; gap: 15px; padding-bottom: 24px; border-bottom: 1px solid var(--line); } label { display: grid; gap: 7px; flex: 1; font-size: 13px; } label span { color: #bf7e21; } input { min-height: 43px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 4px; color: var(--ink); background: #fcfefd; font-size: 14px; outline: none; } input:focus { border-color: #6d9b70; box-shadow: 0 0 0 3px rgba(70, 135, 80, .12); } button { display: inline-flex; align-items: center; gap: 7px; min-height: 43px; padding: 0 24px; border: 0; border-radius: 4px; color: white; background: var(--green); cursor: pointer; font-size: 13px; } button.reset { color: var(--ink); background: #e8eee9; } button:hover { filter: brightness(.92); }
    .tree-title { margin: 28px 0 13px; font-size: 18px; font-weight: 600; display: flex; align-items: center; gap: 9px; } .tree-title i { color: var(--green); } .section-hint { margin: -6px 0 18px; color: var(--muted); font-size: 12px; } .legend { display: flex; justify-content: center; gap: 26px; margin-bottom: 28px; color: var(--muted); font-size: 12px; } .legend span { display: inline-flex; align-items: center; gap: 6px; } .dot { width: 13px; height: 13px; border-radius: 50%; background: var(--active); } .dot.inactive { background: var(--inactive); } .dot.vacant { background: var(--vacant); }
    .tree { min-height: 330px; overflow: auto; padding: 20px 20px 40px; text-align: center; } .node { position: relative; display: inline-flex; flex-direction: column; align-items: center; min-width: 150px; padding: 13px 16px; border: 1px solid #d9e4db; border-radius: 8px; background: #fbfefb; box-shadow: 0 3px 8px rgba(39, 75, 48, .08); cursor: pointer; } .node:hover { border-color: #7fb087; } .node::before { content: ''; display: block; width: 18px; height: 18px; margin-bottom: 8px; border-radius: 50%; background: var(--active); } .node.inactive::before { background: var(--inactive); } .node.vacant::before { background: var(--vacant); } .node strong { font-size: 13px; } .node small { margin-top: 3px; color: var(--muted); font-size: 11px; } .connector { width: 2px; height: 34px; margin: 0 auto; background: #b7cdbb; } .branches { display: flex; justify-content: center; gap: 36px; position: relative; } .branches::before { content: ''; position: absolute; top: 0; left: 25%; right: 25%; height: 2px; background: #b7cdbb; } .branch { position: relative; padding-top: 22px; } .branch::before { content: ''; position: absolute; top: 0; left: 50%; width: 2px; height: 22px; background: #b7cdbb; } .empty-state { display: none; margin-top: 24px; color: var(--muted); font-size: 13px; }
    .table-wrap { overflow-x: auto; margin-top: 16px; } .results-table { width: 100%; border-collapse: collapse; font-size: 12.5px; } .results-table th, .results-table td { padding: 12px 14px; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; } .results-table th { color: var(--muted); background: #f3f8f3; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; } .results-table tbody tr:hover { background: #f6faf6; } .empty-row { color: var(--muted); text-align: center; white-space: normal; padding: 22px !important; }
    .badge-pill { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; } .badge-pill.status-active { color: #1f7a34; background: #e3f5e6; } .badge-pill.status-inactive { color: #a13a34; background: #fbe7e5; } .badge-pill.status-pending { color: #91650f; background: #fdf1dc; } .badge-rank { display: inline-flex; padding: 3px 10px; border-radius: 6px; color: #2a5b3d; background: #eaf3ea; font-size: 11px; font-weight: 600; }
    .perf-summary { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 4px; } .perf-card { flex: 1; min-width: 160px; display: flex; align-items: center; gap: 13px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 8px; background: #fbfefb; } .perf-card .perf-icon { display: grid; place-items: center; flex: 0 0 42px; width: 42px; height: 42px; border-radius: 50%; color: #fff; font-size: 18px; } .perf-card.total .perf-icon { background: #3d7a4e; } .perf-card.active .perf-icon { background: #56a45b; } .perf-card.inactive .perf-icon { background: #d66b61; } .perf-card.sales .perf-icon { background: #bf7e21; } .perf-card strong { display: block; font-size: 20px; line-height: 1.2; } .perf-card span { color: var(--muted); font-size: 12px; }
    footer { margin-left: 248px; padding: 20px; color: var(--muted); text-align: center; font-size: 11px; }
    @@media (max-width: 800px) { .sidebar { width: 62px; padding-left: 14px; padding-right: 14px; } .sidebar .brand span, .sidebar nav a span, .sidebar .nav-label { display: none; } nav a { justify-content: center; padding: 0; } .top, footer { margin-left: 62px; } main { width: min(calc(100% - 94px), 1080px); } }
    @@media (max-width: 620px) { .sidebar { display: none; } .top, footer { margin-left: 0; } main { width: calc(100% - 20px); margin-top: 14px; } .panel { padding: 20px 16px 28px; } .lookup { align-items: stretch; flex-direction: column; } .lookup button { width: 100%; } .legend { gap: 10px; flex-wrap: wrap; } .branches { gap: 14px; } .node { min-width: 126px; padding: 11px 8px; } }
</style>
}

@section Scripts {
<script>
    const authHeaders = { Authorization: `Bearer ${localStorage.getItem('vitality.accessToken') || ''}` };
    const form = document.querySelector('#lookup'); const tree = document.querySelector('#tree'); const empty = document.querySelector('#empty');
    const renderTree = (node) => { tree.innerHTML = `<div class="node ${node.status.toLowerCase()}" tabindex="0"><strong>${node.userId}</strong><small>${node.name}</small></div>${node.children.length ? `<div class="connector"></div><div class="branches">${node.children.map((child) => `<div class="branch"><div class="node ${child.status.toLowerCase()}" tabindex="0"><strong>${child.userId}</strong><small>${child.name}</small></div></div>`).join('')}</div>` : ''}`; empty.style.display = 'none'; };
    const loadTree = async (userId) => { if (!userId) return; const response = await fetch(`/api/network/tree/${encodeURIComponent(userId)}`, { headers: authHeaders }); if (!response.ok) { tree.replaceChildren(); empty.style.display = 'block'; return; } renderTree(await response.json()); };
    form.addEventListener('submit', (event) => { event.preventDefault(); if (!form.checkValidity()) { form.reportValidity(); return; } loadTree(document.querySelector('#userId').value.trim()).catch(() => { tree.replaceChildren(); empty.style.display = 'block'; }); });
    document.querySelector('#reset').addEventListener('click', () => { fetch('/api/profile', { headers: authHeaders }).then((r) => r.json()).then((profile) => { document.querySelector('#userId').value = profile.username; loadTree(profile.username); }); });
    fetch('/api/profile', { headers: authHeaders }).then((r) => r.json()).then((profile) => { document.querySelector('#userId').value = profile.username; loadTree(profile.username); });

    const searchForm = document.querySelector('#searchForm'); const searchRows = document.querySelector('#searchRows');
    searchForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const query = document.querySelector('#query').value.trim();
      const response = await fetch(`/api/network/search?query=${encodeURIComponent(query)}`, { headers: authHeaders });
      const results = response.ok ? await response.json() : [];
      const statusBadge = (status) => `<span class="badge-pill status-${status.toLowerCase()}">${status}</span>`;
      searchRows.innerHTML = results.length ? results.map((item) => `<tr><td>${item.level}</td><td>${item.userId}</td><td>${item.fullName}</td><td>${item.sponsorId}</td><td>${statusBadge(item.status)}</td><td><span class="badge-rank">${item.rank}</span></td></tr>`).join('') : '<tr><td colspan="6" class="empty-row">No matching team members found.</td></tr>';
    });

    fetch('/api/network/team-performance', { headers: authHeaders }).then((r) => r.ok ? r.json() : null).then((perf) => {
      if (!perf) return;
      document.querySelector('#perfSummary').innerHTML = `<div class="perf-card total"><i class="bi bi-people-fill perf-icon"></i><div><strong>${perf.totalMembers}</strong><span>Total Team Members</span></div></div><div class="perf-card active"><i class="bi bi-person-check-fill perf-icon"></i><div><strong>${perf.activeCount}</strong><span>Active</span></div></div><div class="perf-card inactive"><i class="bi bi-person-dash-fill perf-icon"></i><div><strong>${perf.inactiveCount}</strong><span>Inactive</span></div></div><div class="perf-card sales"><i class="bi bi-cash-coin perf-icon"></i><div><strong>R${Number(perf.totalTeamSales).toFixed(2)}</strong><span>Total Team Sales</span></div></div>`;
      const rows = document.querySelector('#perfRows');
      rows.innerHTML = perf.levels.length ? perf.levels.map((level) => `<tr><td>${level.level}</td><td>${level.memberCount}</td><td>${level.activeCount}</td><td>${level.inactiveCount}</td><td>R${Number(level.teamSales).toFixed(2)}</td></tr>`).join('') : '<tr><td colspan="5" class="empty-row">No downline members yet.</td></tr>';
    });
  </script>
}


