@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "News";
}

<section class="panel">
  <h1><i class="bi bi-newspaper"></i> Latest News &amp; Announcements</h1>
  <p class="intro">Stay up to date with the latest platform announcements, bonus qualifications, and updates.</p>

  <article class="news-post">
    <div class="news-banner">
      <div class="news-brand">
        <strong>ScaleEngine</strong>
        <span>PARTNER PLATFORM</span>
      </div>
      <div class="news-date"><i class="bi bi-calendar3"></i> 2026 Announcements</div>
    </div>
    <div class="news-body">
      <h2>Welcome to ScaleEngine Partner Platform</h2>
      <p class="news-lead">We are excited to roll out new performance tiers, automated weekly bonus calculations, real-time rank tracking, and seamless team structure visibility.</p>
      <p>Explore your Dashboard, register new partners with your unique invite link, and track downline performance directly from the Team Structure tab.</p>
      <div class="news-footer">
        <span class="news-tag"><i class="bi bi-tag"></i> Platform Update</span>
        <span class="news-tag"><i class="bi bi-shield-check"></i> Official</span>
      </div>
    </div>
  </article>
</section>

@section Styles {
<style>
  :root { --green: #24272b; --deep: #14161a; --ink: #27372f; --muted: #7b857e; --paper: #fff; --bg: #f4f7f4; --line: #dce6de; }
  * { box-sizing: border-box; }
  .panel { padding: 25px 30px 30px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper); box-shadow: 0 8px 24px rgba(30, 59, 39, .06); }
  h1 { margin: 0 0 8px; font-size: 21px; display: flex; align-items: center; gap: 10px; }
  h1 i { color: var(--green); }
  .intro { margin: 0 0 25px; color: var(--muted); font-size: 13px; }
  .news-post { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: #fbfefb; }
  .news-banner { display: flex; justify-content: space-between; align-items: center; padding: 28px 24px; background: linear-gradient(135deg, #14161a, #24272b); color: #fff; }
  .news-brand strong { display: block; font-size: 22px; font-family: Georgia, serif; letter-spacing: .02em; }
  .news-brand span { font-size: 11px; color: #a9b5ab; letter-spacing: .12em; font-weight: 600; }
  .news-date { font-size: 12px; color: #d0dcd2; display: flex; align-items: center; gap: 6px; }
  .news-body { padding: 24px; }
  .news-body h2 { margin: 0 0 12px; font-size: 18px; color: var(--ink); }
  .news-lead { font-size: 14px; font-weight: 500; color: #37473f; line-height: 1.5; margin-bottom: 12px; }
  .news-body p { margin: 0 0 16px; color: var(--muted); font-size: 13px; line-height: 1.6; }
  .news-footer { display: flex; gap: 8px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); }
  .news-tag { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 999px; background: #eef4f0; color: #27372f; font-size: 11px; font-weight: 600; }
</style>
}