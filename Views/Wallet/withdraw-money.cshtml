@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Withdraw Money";
}

<section class="panel">
  <h1>Withdraw Money</h1>

  <div id="kycAlert" class="info" style="display:none; margin-bottom: 20px;">
    <strong id="kycAlertTitle"><i class="bi bi-shield-lock"></i> KYC Verification Status</strong>
    <span id="kycAlertMsg">Checking KYC compliance...</span>
  </div>

  <form id="withdrawForm">
    <div class="form-grid">
      <div class="field"><label for="amount">Amount(R)</label><input id="amount" type="number" min="100" placeholder="Enter amount" required></div>
      <div class="field"><label for="method">Payment Method</label><select id="method"><option>Bank Transfer</option></select></div>
      <div class="info"><strong>Current Balance</strong>R0</div>
      <div class="info"><strong>Withdrawal fee</strong>R20</div>
      <div class="info"><strong>Minimum withdrawal amount</strong>R100</div>
      <div class="field"><label for="password">Transaction Password</label><input id="password" type="password" placeholder="Transaction Password" required></div>
      <div class="actions"><button type="submit" id="withdrawBtn">Withdraw Money</button><a class="cancel" href="dashboard.html">Cancel</a></div>
    </div>
    <p class="note">If you have not set transaction password yet, <a href="change-trans-password.html">Click Here</a>.</p>
    <p class="status" id="status" role="status" aria-live="polite"></p>
  </form>
  <h2>Current Pending Withdrawal</h2><div class="tools"><span>Show <select><option>10</option><option>25</option><option>50</option><option>100</option></select> entries</span><label>Search: <input id="search" placeholder="Search"></label></div><table><thead><tr><th>Amount(R)</th><th>Payment Method</th><th>Date</th><th>Action</th></tr></thead><tbody><tr><td class="empty" colspan="4">No data available in table</td></tr></tbody></table></section>

@section Styles {
<style>
:root { --green: #24272b; --deep: #14161a; --ink: #27372f; --muted: #7b857e; --paper: #fff; --bg: #f4f7f4; --line: #dce6de; --warn: #fff7df; }
    * { box-sizing: border-box; } body { margin: 0; color: var(--ink); background: var(--bg); font-family: 'Segoe UI', Tahoma, sans-serif; } .sidebar { position: fixed; inset: 0 auto 0 0; width: 248px; padding: 22px 14px; overflow-y: auto; color: #dce9de; background: var(--deep); } .brand { display: flex; align-items: center; gap: 11px; padding: 8px 10px 27px; color: white; font: italic 700 25px Georgia, serif; } .leaf { width: 28px; height: 35px; border-radius: 100% 0 100% 0; background: #3a3f45; transform: rotate(-25deg); }
    nav a, .nav-label { display: flex; align-items: center; gap: 12px; min-height: 39px; padding: 0 12px; border-radius: 5px; color: inherit; text-decoration: none; font-size: 13px; } nav a:hover, nav a.active { color: white; background: rgba(255,255,255,.13); } .icon { width: 19px; text-align: center; font-size: 16px; } .nav-label { min-height: 30px; margin-top: 12px; color: #8daf98; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; } .subnav { margin: 0 0 8px 31px; padding-left: 11px; border-left: 1px solid #466953; } .subnav a { min-height: 36px; padding-left: 7px; font-size: 12px; } .subnav a.active { color: white; background: rgba(255,255,255,.13); }
    .top { min-height: 68px; margin-left: 248px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; color: white; background: var(--deep); } .top a { color: #d8e9da; font-size: 13px; text-decoration: none; } main { width: min(calc(100% - 280px), 1060px); margin: 28px auto 50px; } .panel { padding: 25px 30px 30px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper); box-shadow: 0 8px 24px rgba(30, 59, 39, .06); } h1, h2 { margin: 0 0 22px; font-size: 21px; } h2 { margin-top: 28px; padding-top: 25px; border-top: 1px solid var(--line); font-size: 17px; } .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 17px 22px; } .field { display: grid; gap: 7px; } label { font-size: 13px; } input, select { width: 100%; min-height: 43px; padding: 9px 12px; border: 1px solid var(--line); border-radius: 4px; color: var(--ink); background: var(--paper); font: 14px 'Segoe UI', sans-serif; outline: none; } input:focus, select:focus { border-color: #6d9b70; box-shadow: 0 0 0 3px rgba(70, 135, 80, .12); } .info { padding: 13px 14px; border: 1px solid #e6dcac; border-radius: 4px; color: #62551d; background: var(--warn); font-size: 12px; line-height: 1.55; } .info strong { display: block; margin-bottom: 3px; } .actions { display: flex; gap: 12px; margin-top: 3px; } button, .cancel { min-height: 43px; padding: 0 22px; border: 0; border-radius: 4px; color: white; background: var(--green); cursor: pointer; font-size: 13px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; } .cancel { color: var(--ink); background: #e8eee9; } button:hover { background: #000000; } .note { margin-top: 18px; color: var(--muted); font-size: 12px; } .note a { color: var(--green); font-weight: 600; } .status { min-height: 20px; margin: 14px 0 0; color: #1f7a34; font-size: 13px; } table { width: 100%; border-collapse: collapse; font-size: 12px; } th, td { padding: 12px 9px; border-bottom: 1px solid var(--line); text-align: left; } th { color: var(--muted); background: #f8fbf8; font-size: 11px; } td.empty { padding: 27px; color: var(--muted); text-align: center; } .tools { display: flex; justify-content: space-between; margin-bottom: 10px; color: var(--muted); font-size: 12px; } footer { margin-left: 248px; padding: 20px; color: var(--muted); text-align: center; font-size: 11px; }
    @@media (max-width: 800px) { .sidebar { width: 62px; padding-left: 14px; padding-right: 14px; } .sidebar .brand span, .sidebar nav a span, .sidebar .nav-label, .sidebar .subnav { display: none; } nav a { justify-content: center; padding: 0; } .top, footer { margin-left: 62px; } main { width: min(calc(100% - 94px), 1060px); } } @@media (max-width: 620px) { .sidebar { display: none; } .top, footer { margin-left: 0; } main { width: calc(100% - 20px); margin-top: 14px; } .panel { padding: 21px 16px 25px; } .form-grid { grid-template-columns: 1fr; } .actions { flex-direction: column; } .actions button, .actions .cancel { width: 100%; } .tools { align-items: flex-start; flex-direction: column; gap: 10px; } .tools input { width: 100%; } .top { padding: 0 16px; } }
</style>
}

@section Scripts {
<script>
  const token = localStorage.getItem('vitality.accessToken');
  const authHeaders = () => ({ 'Content-Type': 'application/json', 'Authorization': `Bearer ${token || ''}` });

  if (token) {
    fetch('/api/kyc/status', { headers: authHeaders() })
      .then((r) => r.ok ? r.json() : null)
      .then((kyc) => {
        const alertBox = document.querySelector('#kycAlert');
        const alertTitle = document.querySelector('#kycAlertTitle');
        const alertMsg = document.querySelector('#kycAlertMsg');

        if (!kyc || kyc.status !== 'Verified') {
          alertBox.style.display = 'block';
          alertBox.style.background = '#fee2e2';
          alertBox.style.borderColor = '#fca5a5';
          alertBox.style.color = '#991b1b';
          alertTitle.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> KYC Verification Required';
          alertMsg.innerHTML = `Your KYC status is <strong>${kyc ? kyc.status : 'Unverified'}</strong>. FICA regulations require verified ID &amp; Address before requesting payouts. <a href="profile.html#kyc" style="color:#b91c1c; font-weight:700; text-decoration:underline;">Click here to complete KYC in your Profile</a>.`;
        } else {
          alertBox.style.display = 'block';
          alertBox.style.background = '#ecfdf5';
          alertBox.style.borderColor = '#a7f3d0';
          alertBox.style.color = '#065f46';
          alertTitle.innerHTML = '<i class="bi bi-patch-check-fill" style="color:#10b981;"></i> KYC Compliance Verified';
          alertMsg.textContent = 'Your identity and address are verified. Payouts are fully enabled.';
        }
      })
      .catch(() => {});
  }

  document.querySelector('#withdrawForm').addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const status = document.querySelector('#status');
    if (!form.checkValidity()) { form.reportValidity(); return; }
    try {
      const response = await fetch('/api/wallet/withdrawals', {
        method: 'POST',
        headers: authHeaders(),
        body: JSON.stringify({ amount: Number(amount.value), paymentMethod: method.value, transactionPassword: password.value })
      });
      const result = await response.json();
      status.style.color = response.ok ? '#1f7a34' : '#b4473e';
      status.textContent = result.message || 'Please log in before requesting a withdrawal.';
    } catch {
      status.style.color = '#b4473e';
      status.textContent = 'Unable to contact the server.';
    }
  });
</script>
}


