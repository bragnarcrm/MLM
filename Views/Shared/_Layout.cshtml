<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"] | ScaleEngine</title>
  <script>
    // Guard: every page using this layout requires a session token; bounce anonymous visitors to login.
    if (!window.localStorage.getItem('vitality.accessToken')) { window.location.replace('/login.html'); }
  </script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  @RenderSection("Styles", required: false)
  <link rel="stylesheet" href="/css/portal-navigation.css?v=9">
  <style>
    :root { --portal-deep: #0d0f12; --portal-bg: #f3f5f8; --portal-line: #e2e8f0; --portal-muted: #64748b; }
    body { min-width: 0; margin: 0; color: #1e293b; background: var(--portal-bg); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
    .portal-shell { min-height: 100vh; display: flex; }
    .portal-main { min-width: 0; flex: 1; margin-left: 252px; display: flex; flex-direction: column; min-height: 100vh; }
    .portal-header { position: sticky; top: 0; z-index: 90; min-height: 62px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; color: #fff; background: var(--portal-deep); border-bottom: 1px solid #1c212a; }
    .portal-header-toggle { display: none; place-items: center; width: 36px; height: 36px; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 6px; color: #fff; background: rgba(255, 255, 255, 0.06); font-size: 20px; cursor: pointer; transition: all .15s ease; }
    .portal-header-toggle:hover { background: rgba(255, 255, 255, 0.14); }
    .portal-content { max-width: 1240px; width: 100%; margin: 0 auto; padding: 26px 28px 48px; flex: 1; }
    .portal-card { border: 1px solid var(--portal-line); border-radius: 8px; background: #fff; box-shadow: 0 4px 18px rgba(0, 0, 0, .04); }
    .portal-footer { margin-left: 252px; padding: 18px 28px; color: var(--portal-muted); text-align: center; font-size: 11.5px; border-top: 1px solid #e2e8f0; background: #fff; }
    @@media (max-width: 820px) { .portal-main { margin-left: 62px; } .portal-header-toggle { display: grid; } .portal-content { padding: 20px 16px 36px; } .portal-footer { margin-left: 62px; } }
    @@media (max-width: 620px) { .portal-main { margin-left: 0; } .portal-header { padding: 0 14px; } .portal-header-toggle { display: grid; } .portal-content { padding: 14px 10px 30px; } .portal-footer { margin-left: 0; } }
  </style>
</head>
<body>
  <div class="portal-shell">
    @await Html.PartialAsync("_PortalNavigation")
    <div class="portal-main">
      <header class="portal-header">
        <div class="portal-header-left">
          <button class="portal-header-toggle" id="portalNavToggleBtn" type="button" aria-label="Toggle navigation"><i class="bi bi-list"></i></button>
          <span class="portal-header-badge"><i class="bi bi-shield-lock-fill"></i> ScaleEngine Platform</span>
        </div>
        <div class="portal-header-right">
          <button class="portal-header-action" id="headerShare" type="button" title="Share invite link"><i class="bi bi-share"></i> <span>Invite</span></button>
          <a class="portal-header-btn" href="notifications.html" aria-label="Notifications" title="Notifications">
            <i class="bi bi-bell"></i>
            <span class="portal-header-badge-count" id="headerNotifBadge">0</span>
          </a>
          <a class="portal-profile" href="profile.html" title="My Account">
            <span class="portal-profile-avatar" id="headerAvatar">?</span>
            <div class="portal-profile-details">
              <span class="portal-profile-name" id="headerName">Account</span>
              <span class="portal-profile-rank" id="headerRank">Rank: ...</span>
            </div>
          </a>
        </div>
      </header>
      <main class="portal-content">@RenderBody()</main>
    </div>
  </div>
  <footer class="portal-footer">2026 © ScaleEngine. All rights reserved.</footer>
  <script src="/js/translator-engine.js?v=1"></script>
  <script src="/js/saas-engine.js?v=1"></script>
  <script src="/js/portal-session.js?v=9"></script>
  @RenderSection("Scripts", required: false)
</body>
</html>
