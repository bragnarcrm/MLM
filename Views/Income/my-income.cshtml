@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Income";
}

<section class="panel"><h1>All Commission</h1><p class="intro">Review your commission and income summaries.</p><div class="income-grid"><a class="income-card" href="my-commission.html"><strong>R0.0</strong><span>All Commission</span></a><a class="income-card" href="direct-referral-bonus.html"><strong>R0.0</strong><span>Direct Referral Bonus</span></a><a class="income-card" href="level-bonus.html"><strong>R0.0</strong><span>Level Bonus</span></a><a class="income-card" href="rank-bonus.html"><strong>R0.0</strong><span>Rank Bonuses</span></a><a class="income-card" href="rank-history.html"><strong>N/A</strong><span>Rank Achievers</span></a><a class="income-card" href="level-turnover.html"><strong>R0.0</strong><span>Level Turnover</span></a><a class="income-card" href="monthly-salary.html"><strong>R0.0</strong><span>Monthly Salary</span></a></div></section>

@section Styles {
<style>
:root { --green: #24272b; --deep: #14161a; --ink: #27372f; --muted: #7b857e; --paper: #fff; --bg: #f4f7f4; --line: #dce6de; }
    * { box-sizing: border-box; } body { margin: 0; color: var(--ink); background: var(--bg); font-family: 'Segoe UI', Tahoma, sans-serif; }
    .sidebar { position: fixed; inset: 0 auto 0 0; width: 248px; padding: 22px 14px; overflow-y: auto; color: #dce9de; background: var(--deep); } .brand { display: flex; align-items: center; gap: 11px; padding: 8px 10px 27px; color: white; font: italic 700 25px Georgia, serif; } .leaf { width: 28px; height: 35px; border-radius: 100% 0 100% 0; background: #3a3f45; transform: rotate(-25deg); }
    nav a, .nav-label { display: flex; align-items: center; gap: 12px; min-height: 39px; padding: 0 12px; border-radius: 5px; color: inherit; text-decoration: none; font-size: 13px; } nav a:hover, nav a.active { color: white; background: rgba(255,255,255,.13); } .icon { width: 19px; text-align: center; font-size: 16px; } .nav-label { min-height: 30px; margin-top: 12px; color: #8daf98; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; } .subnav { margin: 0 0 8px 31px; padding-left: 11px; border-left: 1px solid #466953; } .subnav a { min-height: 36px; padding-left: 7px; font-size: 12px; } .subnav a.active { color: white; background: rgba(255,255,255,.13); }
    .top { min-height: 68px; margin-left: 248px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; color: white; background: var(--deep); } .top a { color: #d8e9da; font-size: 13px; text-decoration: none; }
    main { width: min(calc(100% - 280px), 1080px); margin: 28px auto 50px; } .panel { padding: 25px 30px 30px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper); box-shadow: 0 8px 24px rgba(30, 59, 39, .06); } h1 { margin: 0 0 7px; font-size: 21px; } .intro { margin: 0 0 24px; color: var(--muted); font-size: 13px; } .income-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; } .income-card { display: block; padding: 18px; border: 1px solid var(--line); border-radius: 6px; color: var(--ink); text-decoration: none; background: #fbfefb; } .income-card:hover { border-color: #7eac83; } .income-card strong { display: block; margin-bottom: 6px; font-size: 21px; } .income-card span { color: var(--muted); font-size: 12px; } footer { margin-left: 248px; padding: 20px; color: var(--muted); text-align: center; font-size: 11px; }
    @@media (max-width: 800px) { .sidebar { width: 62px; padding-left: 14px; padding-right: 14px; } .sidebar .brand span, .sidebar nav a span, .sidebar .nav-label, .sidebar .subnav { display: none; } nav a { justify-content: center; padding: 0; } .top, footer { margin-left: 62px; } main { width: min(calc(100% - 94px), 1080px); } .income-grid { grid-template-columns: repeat(2, 1fr); } } @@media (max-width: 620px) { .sidebar { display: none; } .top, footer { margin-left: 0; } main { width: calc(100% - 20px); margin-top: 14px; } .panel { padding: 21px 16px 25px; } .income-grid { grid-template-columns: 1fr 1fr; gap: 9px; } .income-card { padding: 13px; } .income-card strong { font-size: 17px; } .top { padding: 0 16px; } }
</style>
}

@section Scripts {
<script>const token = localStorage.getItem('vitality.accessToken'); if (token) fetch('/api/income/summary', { headers: { Authorization: `Bearer ${token}` } }).then((response) => response.ok ? response.json() : null).then((summary) => { if (!summary) return; const values = [summary.allCommission, summary.directReferralBonus, summary.levelBonus, summary.rankBonus, null, summary.levelTurnover, summary.monthlySalary]; document.querySelectorAll('.income-card strong').forEach((element, index) => { if (values[index] !== null) element.textContent = `R${values[index].toFixed(2)}`; }); });</script>
}


