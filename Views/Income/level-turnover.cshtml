@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Level Turnover";
}

<section class="panel"><h1>Level Turnover</h1><form class="filters" id="filters"><label>Month<select id="month"><option>January</option><option>February</option><option>March</option><option>April</option><option>May</option><option>June</option><option>July</option><option>August</option><option selected>September</option><option>October</option><option>November</option><option>December</option></select></label><label>Year<select id="year"><option>2024</option><option>2025</option><option selected>2026</option><option>2027</option></select></label><button type="submit">Submit</button><button class="reset" type="button" id="reset">Reset</button></form><p class="showing">Showing data for: <strong id="showing">September 2026</strong></p><div class="table-tools"><label>Show <select id="entries"><option>10</option><option>25</option><option>50</option><option>100</option></select> entries</label><label>Search: <input id="search" placeholder="Search"></label></div><div class="table-wrap"><table><thead><tr><th>Level</th><th>Turnover(R)</th></tr></thead><tbody id="rows"><tr><td class="empty" colspan="2" id="empty">Loading...</td></tr></tbody></table></div><div class="footer-row"><span id="count">Showing 0 to 0 of 0 entries</span><span class="pager"><button type="button" id="prevPage">Previous</button><button type="button" id="nextPage">Next</button></span></div></section>

@section Styles {
<style>
:root { --green: #24272b; --deep: #14161a; --ink: #27372f; --muted: #7b857e; --paper: #fff; --bg: #f4f7f4; --line: #dce6de; }
    * { box-sizing: border-box; } body { margin: 0; color: var(--ink); background: var(--bg); font-family: 'Segoe UI', Tahoma, sans-serif; } .sidebar { position: fixed; inset: 0 auto 0 0; width: 248px; padding: 22px 14px; overflow-y: auto; color: #dce9de; background: var(--deep); } .brand { display: flex; align-items: center; gap: 11px; padding: 8px 10px 27px; color: white; font: italic 700 25px Georgia, serif; } .leaf { width: 28px; height: 35px; border-radius: 100% 0 100% 0; background: #3a3f45; transform: rotate(-25deg); } nav a, .nav-label { display: flex; align-items: center; gap: 12px; min-height: 39px; padding: 0 12px; border-radius: 5px; color: inherit; text-decoration: none; font-size: 13px; } nav a:hover, nav a.active { color: white; background: rgba(255,255,255,.13); } .icon { width: 19px; text-align: center; font-size: 16px; } .nav-label { min-height: 30px; margin-top: 12px; color: #8daf98; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; } .subnav { margin: 0 0 8px 31px; padding-left: 11px; border-left: 1px solid #466953; } .subnav a { min-height: 36px; padding-left: 7px; font-size: 12px; } .subnav a.active { color: white; background: rgba(255,255,255,.13); }
    .top { min-height: 68px; margin-left: 248px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; color: white; background: var(--deep); } .top a { color: #d8e9da; font-size: 13px; text-decoration: none; } main { width: min(calc(100% - 280px), 900px); margin: 28px auto 50px; } .panel { padding: 25px 30px 30px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper); box-shadow: 0 8px 24px rgba(30, 59, 39, .06); } h1 { margin: 0 0 24px; font-size: 21px; } .filters { display: flex; align-items: end; gap: 15px; padding-bottom: 24px; border-bottom: 1px solid var(--line); } label { display: grid; gap: 7px; flex: 1; color: var(--ink); font-size: 13px; } select, input { min-height: 40px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 4px; color: var(--ink); background: var(--paper); font: 13px 'Segoe UI', sans-serif; } button { min-height: 40px; padding: 0 22px; border: 0; border-radius: 4px; color: white; background: var(--green); cursor: pointer; font-size: 13px; } button.reset { color: var(--ink); background: #e8eee9; } button:hover { filter: brightness(.92); } .showing { margin: 21px 0; color: var(--muted); font-size: 13px; } .showing strong { color: var(--ink); } .table-tools { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; color: var(--muted); font-size: 12px; } .table-wrap { overflow-x: auto; } table { width: 100%; border-collapse: collapse; font-size: 13px; } th, td { padding: 12px 10px; border-bottom: 1px solid var(--line); text-align: left; } th { color: var(--muted); background: #f8fbf8; font-size: 11px; } td:last-child, th:last-child { text-align: right; } .footer-row { display: flex; justify-content: space-between; margin-top: 14px; color: var(--muted); font-size: 11px; } .pager { display: flex; gap: 14px; } .pager button { min-height: auto; padding: 0; border: 0; color: var(--muted); background: transparent; } footer { margin-left: 248px; padding: 20px; color: var(--muted); text-align: center; font-size: 11px; }
    @@media (max-width: 800px) { .sidebar { width: 62px; padding-left: 14px; padding-right: 14px; } .sidebar .brand span, .sidebar nav a span, .sidebar .nav-label, .sidebar .subnav { display: none; } nav a { justify-content: center; padding: 0; } .top, footer { margin-left: 62px; } main { width: min(calc(100% - 94px), 900px); } } @@media (max-width: 620px) { .sidebar { display: none; } .top, footer { margin-left: 0; } main { width: calc(100% - 20px); margin-top: 14px; } .panel { padding: 21px 16px 25px; } .filters { align-items: stretch; flex-direction: column; } .filters button { width: 100%; } .table-tools { align-items: flex-start; flex-direction: column; gap: 10px; } .table-tools input { width: 100%; } .top { padding: 0 16px; } }
</style>
}

@section Scripts {
<script src="/js/portal-table.js"></script>
<script>
  document.querySelector('#filters').addEventListener('submit', (event) => { event.preventDefault(); document.querySelector('#showing').textContent = document.querySelector('#month').value + ' ' + document.querySelector('#year').value; });
  document.querySelector('#reset').addEventListener('click', () => { document.querySelector('#month').value = 'September'; document.querySelector('#year').value = '2026'; document.querySelector('#showing').textContent = 'September 2026'; });
  initPortalTable({
    url: '/api/income/level-turnover',
    columnCount: 2,
    mapItems: (data) => data || [],
    prevBtn: document.querySelector('#prevPage'),
    nextBtn: document.querySelector('#nextPage'),
    matches: (item, term) => `level ${item.level}`.includes(term),
    searchMessage: 'No matching level',
    errorMessage: 'Unable to load level turnover.',
    renderRow: (item) => `<tr><td>${item.level}</td><td>R${Number(item.turnover).toFixed(2)}</td></tr>`
  });
</script>
}


