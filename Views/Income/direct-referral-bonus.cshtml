@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Direct Referral Bonus";
}

<section class="portal-card p-3 p-md-4">
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
      <h1 class="h4 mb-1">Direct Referral Bonus</h1>
      <p class="text-secondary mb-0">Review commissions earned from your direct referrals.</p>
    </div>
    <button class="btn btn-outline-success btn-sm" id="export" type="button">Export</button>
  </div>
  <div class="row g-3 align-items-end mb-3">
    <div class="col-12 col-md-4">
      <label class="form-label small text-secondary" for="entries">Show entries</label>
      <select class="form-select form-select-sm" id="entries"><option>10</option><option>25</option><option>50</option><option>100</option></select>
    </div>
    <div class="col-12 col-md-8">
      <label class="form-label small text-secondary" for="search">Search</label>
      <input class="form-control form-control-sm" id="search" placeholder="Search bonus records">
    </div>
  </div>
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>SL No.</th><th>Date</th><th>From User ID</th><th>Commission Name</th><th>Amount (R)</th><th>Paid Status</th></tr></thead>
      <tbody id="bonusRows"><tr><td class="text-center text-secondary py-4" colspan="6">Loading bonus records...</td></tr></tbody>
    </table>
  </div>
  <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 pt-3 small text-secondary">
    <div id="count">Showing 0 to 0 of 0 entries</div>
    <div class="d-flex gap-2"><button type="button" class="btn btn-outline-secondary btn-sm" id="prevPage">Previous</button><button type="button" class="btn btn-outline-secondary btn-sm" id="nextPage">Next</button></div>
  </div>
</section>

@section Scripts {
<script src="/js/portal-table.js"></script>
<script>
  initPortalTable({
    url: '/api/income/commissions/direct',
    tbody: document.querySelector('#bonusRows'),
    countEl: document.querySelector('#count'),
    searchEl: document.querySelector('#search'),
    entriesEl: document.querySelector('#entries'),
    prevBtn: document.querySelector('#prevPage'),
    nextBtn: document.querySelector('#nextPage'),
    columnCount: 6,
    matches: (record, term) => `${record.fromUserId} ${record.name} ${record.status}`.toLowerCase().includes(term),
    searchMessage: 'No matching bonus records',
    emptyMessage: 'No bonus records available',
    errorMessage: 'Unable to load bonus records.',
    renderRow: (record, index) => `<tr><td>${index + 1}</td><td>${record.date}</td><td>${record.fromUserId}</td><td>${record.name}</td><td>R${Number(record.total).toFixed(2)}</td><td>${record.status}</td></tr>`
  });
  document.querySelector('#export').addEventListener('click', () => {});
</script>
}

