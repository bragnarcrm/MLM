@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Shopping Cart";
}

<section class="panel">
  <div class="panel-head">
    <div>
      <h1><i class="bi bi-cart3"></i> Your Shopping Cart</h1>
      <p class="subtitle">Review your selected products, adjust quantities, and proceed to secure checkout.</p>
    </div>
    <a href="shopping.html" class="btn-outline-back"><i class="bi bi-arrow-left"></i> Continue Shopping</a>
  </div>

  <div class="cart-grid">
    <!-- Left: Cart Items Table -->
    <div class="cart-items-panel">
      <table class="cart-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Unit Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="cartRows">
          <!-- Dynamically populated -->
        </tbody>
      </table>

      <div class="cart-empty" id="emptyCart" style="display:none;">
        <i class="bi bi-basket3"></i>
        <h3>Your cart is empty</h3>
        <p>Add some business starter kits or wellness tea packs to get started.</p>
        <a href="shopping.html" class="btn-primary-action"><i class="bi bi-bag-plus"></i> Browse Products</a>
      </div>
    </div>

    <!-- Right: Order Summary Card -->
    <div class="cart-summary-panel">
      <div class="summary-card">
        <h3><i class="bi bi-receipt"></i> Order Summary</h3>
        
        <div class="summary-row">
          <span>Subtotal (Excl. VAT)</span>
          <strong id="summarySubtotal">R 0.00</strong>
        </div>
        <div class="summary-row">
          <span>Standard VAT (15%)</span>
          <strong id="summaryVat">R 0.00</strong>
        </div>
        <div class="summary-row">
          <span>Estimated Shipping</span>
          <span class="text-success font-weight-bold">FREE</span>
        </div>

        <div class="summary-divider"></div>

        <div class="summary-row total-row">
          <span>Total (Incl. VAT)</span>
          <strong id="summaryTotal">R 0.00</strong>
        </div>

        <div class="field mt-3">
          <label for="cartPaymentMethod">Payment Method</label>
          <select id="cartPaymentMethod">
            <option value="PayFast" selected>PayFast Gateway (Card, Instant EFT, QR)</option>
            <option value="Card">Direct Credit / Debit Card</option>
            <option value="Instant EFT">Instant EFT</option>
            <option value="Capitec Pay">Capitec Pay</option>
            <option value="Wallet">Scale Wallet Balance</option>
          </select>
        </div>

        <button type="button" class="btn-checkout" id="checkoutBtn">
          <i class="bi bi-shield-lock-fill"></i> Proceed to Checkout
        </button>

        <p class="status-msg" id="checkoutStatus"></p>

        <div class="cart-security-badge">
          <i class="bi bi-shield-check"></i> 100% Secure &amp; PCI-DSS Level 1 Compliant
        </div>
      </div>
    </div>
  </div>
</section>

@section Styles {
<style>
  :root { --dark: #0f172a; --deep: #0d0f12; --ink: #1e293b; --muted: #64748b; --line: #e2e8f0; --paper: #fff; --bg: #f8fafc; --success: #16a34a; --danger: #dc2626; }
  * { box-sizing: border-box; }

  .panel { padding: 30px 32px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); box-shadow: 0 4px 18px rgba(0,0,0,.04); }
  .panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 14px; }
  h1 { margin: 0 0 4px; font-size: 21px; font-weight: 700; color: var(--dark); display: flex; align-items: center; gap: 9px; }
  .subtitle { margin: 0; color: var(--muted); font-size: 13.5px; }

  .btn-outline-back { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 6px; color: var(--ink); text-decoration: none; font-size: 13px; font-weight: 600; }
  .btn-outline-back:hover { background: #f8fafc; color: var(--dark); }

  .cart-grid { display: grid; grid-template-columns: 1fr 340px; gap: 26px; align-items: start; }
  
  .cart-items-panel { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: #fff; }
  .cart-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .cart-table th, .cart-table td { padding: 14px 16px; border-bottom: 1px solid var(--line); text-align: left; }
  .cart-table th { background: #f8fafc; color: var(--muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  
  .product-cell { display: flex; align-items: center; gap: 12px; }
  .product-icon-wrap { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 8px; background: #0f172a; color: #fff; font-size: 18px; flex-shrink: 0; }
  .product-title { font-weight: 600; color: var(--dark); }
  .product-sub { font-size: 12px; color: var(--muted); }

  .qty-control { display: flex; align-items: center; gap: 6px; }
  .qty-btn { width: 28px; height: 28px; border: 1px solid var(--line); border-radius: 4px; background: #fff; cursor: pointer; display: grid; place-items: center; font-size: 14px; font-weight: bold; }
  .qty-btn:hover { background: #f1f5f9; }
  .qty-input { width: 44px; height: 28px; text-align: center; border: 1px solid var(--line); border-radius: 4px; font-weight: 600; }

  .btn-remove-item { border: 0; background: transparent; color: #94a3b8; cursor: pointer; font-size: 16px; transition: color .15s; }
  .btn-remove-item:hover { color: #dc2626; }

  .cart-empty { padding: 48px 24px; text-align: center; }
  .cart-empty i { font-size: 48px; color: #cbd5e1; margin-bottom: 12px; display: block; }
  .cart-empty h3 { margin: 0 0 6px; font-size: 17px; font-weight: 700; color: var(--dark); }
  .cart-empty p { margin: 0 0 18px; color: var(--muted); font-size: 13.5px; }

  /* Summary Card */
  .summary-card { padding: 22px; border: 1px solid var(--line); border-radius: 8px; background: #fbfefb; }
  .summary-card h3 { margin: 0 0 16px; font-size: 15px; font-weight: 700; color: var(--dark); display: flex; align-items: center; gap: 8px; }
  .summary-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; font-size: 13px; color: #475569; }
  .summary-divider { height: 1px; margin: 14px 0; background: var(--line); }
  .total-row { font-size: 16px; font-weight: 800; color: var(--dark); }
  .total-row strong { font-size: 20px; color: #0f172a; }

  .btn-checkout { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; height: 46px; border: 0; border-radius: 6px; color: #fff; background: var(--dark); font-size: 14.5px; font-weight: 700; cursor: pointer; margin-top: 16px; transition: background .15s; }
  .btn-checkout:hover { background: #000; }
  .btn-checkout:disabled { cursor: wait; opacity: .7; }

  .cart-security-badge { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 14px; color: var(--muted); font-size: 11.5px; text-align: center; }
  .cart-security-badge i { color: #16a34a; font-size: 13px; }

  .btn-primary-action { display: inline-flex; align-items: center; gap: 7px; height: 42px; padding: 0 18px; border: 0; border-radius: 6px; color: white; background: var(--dark); text-decoration: none; font-size: 13.5px; font-weight: 600; }
  .btn-primary-action:hover { background: #000; color: #fff; }

  .status-msg { font-size: 12.5px; font-weight: 600; margin-top: 10px; text-align: center; }
  .status-msg.error { color: var(--danger); }
  .status-msg.success { color: var(--success); }

  @@media (max-width: 820px) {
    .cart-grid { grid-template-columns: 1fr; }
  }
</style>
}

@section Scripts {
<script>
(() => {
  const token = localStorage.getItem('vitality.accessToken');
  const authHeaders = () => ({ 'Content-Type': 'application/json', Authorization: `Bearer ${token || ''}` });

  const getStoredCart = () => {
    try {
      const stored = JSON.parse(localStorage.getItem('scale_cart') || '[]');
      if (Array.isArray(stored) && stored.length > 0) return stored;
    } catch { }
    return [
      { id: 1, name: 'Business Starter Kit', icon: 'bi-briefcase-fill', desc: 'Welcome pack, product catalog & tea samples', price: 499.00, qty: 1, isBusinessKit: true }
    ];
  };

  let cart = getStoredCart();

  const syncCart = () => {
    localStorage.setItem('scale_cart', JSON.stringify(cart));
  };

  const renderCart = () => {
    const tbody = document.querySelector('#cartRows');
    const emptyBox = document.querySelector('#emptyCart');
    const table = document.querySelector('.cart-table');

    if (cart.length === 0) {
      table.style.display = 'none';
      emptyBox.style.display = 'block';
      document.querySelector('#summarySubtotal').textContent = 'R 0.00';
      document.querySelector('#summaryVat').textContent = 'R 0.00';
      document.querySelector('#summaryTotal').textContent = 'R 0.00';
      document.querySelector('#checkoutBtn').disabled = true;
      return;
    }

    table.style.display = 'table';
    emptyBox.style.display = 'none';
    document.querySelector('#checkoutBtn').disabled = false;

    let total = 0;
    tbody.innerHTML = cart.map((item, idx) => {
      const itemTotal = Number(item.price) * Number(item.qty || 1);
      total += itemTotal;
      const icon = item.icon || (item.name.includes('Kit') ? 'bi-briefcase-fill' : 'bi-cup-hot-fill');
      const desc = item.desc || 'Natural herbal botanical formulation';

      return `<tr>
        <td>
          <div class="product-cell">
            <div class="product-icon-wrap"><i class="bi ${icon}"></i></div>
            <div>
              <div class="product-title">${item.name}</div>
              <div class="product-sub">${desc}</div>
            </div>
          </div>
        </td>
        <td><strong>R ${Number(item.price).toFixed(2)}</strong></td>
        <td>
          <div class="qty-control">
            <button type="button" class="qty-btn" onclick="updateQty(${idx}, -1)">&minus;</button>
            <input class="qty-input" value="${item.qty || 1}" readonly>
            <button type="button" class="qty-btn" onclick="updateQty(${idx}, 1)">&plus;</button>
          </div>
        </td>
        <td><strong>R ${itemTotal.toFixed(2)}</strong></td>
        <td>
          <button type="button" class="btn-remove-item" onclick="removeItem(${idx})" title="Remove item">&times;</button>
        </td>
      </tr>`;
    }).join('');

    const subtotal = Math.round((total / 1.15) * 100) / 100;
    const vat = Math.round((total - subtotal) * 100) / 100;

    document.querySelector('#summarySubtotal').textContent = `R ${subtotal.toFixed(2)}`;
    document.querySelector('#summaryVat').textContent = `R ${vat.toFixed(2)}`;
    document.querySelector('#summaryTotal').textContent = `R ${total.toFixed(2)}`;
  };

  window.updateQty = (idx, delta) => {
    if (!cart[idx]) return;
    cart[idx].qty = Math.max(1, (cart[idx].qty || 1) + delta);
    syncCart();
    renderCart();
  };

  window.removeItem = (idx) => {
    cart.splice(idx, 1);
    syncCart();
    renderCart();
  };

  const checkoutBtn = document.querySelector('#checkoutBtn');
  const checkoutStatus = document.querySelector('#checkoutStatus');

  checkoutBtn.addEventListener('click', async () => {
    if (cart.length === 0) return;
    const totalAmount = cart.reduce((sum, item) => sum + (Number(item.price) * Number(item.qty || 1)), 0);
    const method = document.querySelector('#cartPaymentMethod').value;
    const primaryItem = cart.map(i => `${i.qty}x ${i.name}`).join(', ');

    if (method === 'PayFast') {
      window.location.href = `payfast-checkout.html?type=store&amount=${totalAmount}&product=${encodeURIComponent(primaryItem)}`;
      return;
    }

    checkoutBtn.disabled = true;
    checkoutStatus.className = 'status-msg';
    checkoutStatus.textContent = `Authorizing ${method} checkout...`;

    try {
      // Record all purchases
      for (const item of cart) {
        await fetch('/api/purchases', {
          method: 'POST',
          headers: authHeaders(),
          body: JSON.stringify({
            productName: item.name,
            amount: item.price,
            isBusinessKit: !!item.isBusinessKit,
            quantity: item.qty || 1,
            paymentMethod: method
          })
        });
      }

      // Record Order
      const orderRes = await fetch('/api/orders', {
        method: 'POST',
        headers: authHeaders(),
        body: JSON.stringify({
          amount: totalAmount,
          shippingFee: 0,
          paymentMethod: method
        })
      });

      if (!orderRes.ok) throw new Error('Could not record order');

      // Clear cart
      cart = [];
      syncCart();
      renderCart();

      checkoutStatus.className = 'status-msg success';
      checkoutStatus.innerHTML = `Order paid and confirmed! <a href="order-list.html" style="color:#15803d; font-weight:700; text-decoration:underline;">View Order &amp; Tax Invoice &rarr;</a>`;
    } catch (err) {
      checkoutStatus.className = 'status-msg error';
      checkoutStatus.textContent = err.message || 'Payment processing failed. Please try again.';
      checkoutBtn.disabled = false;
    }
  });

  renderCart();
})();
</script>
}
