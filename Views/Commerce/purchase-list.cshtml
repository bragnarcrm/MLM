@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Purchase List";
}

<section class="panel"><h1>Purchase List</h1><div class="toolbar"><label>Show <select id="entries"><option>10</option><option>25</option><option>50</option><option>100</option></select> entries</label><label>Search: <input id="search" placeholder="Search"></label></div><div class="table-wrap"><table><thead><tr><th>SL No.</th><th>Product Name</th><th>Product Amount(R)</th><th>Business Kit</th><th>Quantity</th><th>Total Amount(R)</th><th>Payment Method</th><th>Status</th><th>Date</th></tr></thead><tbody id="rows"><tr><td class="empty" colspan="9" id="empty">No data available in table</td></tr></tbody></table></div><div class="table-footer"><span id="count">Showing 0 to 0 of 0 entries</span><span class="pager"><button type="button" id="prevPage">Previous</button><button type="button" id="nextPage">Next</button></span></div></section>

@section Styles {
<style>
:root { --green: #24272b; --deep: #14161a; --ink: #27372f; --muted: #7b857e; --paper: #fff; --bg: #f4f7f4; --line: #dce6de; }
    * { box-sizing: border-box; } body { margin: 0; color: var(--ink); background: var(--bg); font-family: 'Segoe UI', Tahoma, sans-serif; } .sidebar { position: fixed; inset: 0 auto 0 0; width: 248px; padding: 22px 14px; overflow-y: auto; color: #dce9de; background: var(--deep); } .brand { display: flex; align-items: center; gap: 11px; padding: 8px 10px 27px; color: white; font: italic 700 25px Georgia, serif; } .leaf { width: 28px; height: 35px; border-radius: 100% 0 100% 0; background: #3a3f45; transform: rotate(-25deg); }
    nav a, .nav-label { display: flex; align-items: center; gap: 12px; min-height: 39px; padding: 0 12px; border-radius: 5px; color: inherit; text-decoration: none; font-size: 13px; } nav a:hover, nav a.active { color: white; background: rgba(255,255,255,.13); } .icon { width: 19px; text-align: center; font-size: 16px; } .nav-label { min-height: 30px; margin-top: 12px; color: #8daf98; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; } .subnav { margin: 0 0 8px 31px; padding-left: 11px; border-left: 1px solid #466953; } .subnav a { min-height: 36px; padding-left: 7px; font-size: 12px; } .subnav a.active { color: white; background: rgba(255,255,255,.13); }
    .top { min-height: 68px; margin-left: 248px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; color: white; background: var(--deep); } .top a { color: #d8e9da; font-size: 13px; text-decoration: none; } main { width: min(calc(100% - 280px), 1350px); margin: 28px auto 50px; } .panel { padding: 25px 30px 30px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper); box-shadow: 0 8px 24px rgba(30, 59, 39, .06); } h1 { margin: 0 0 24px; font-size: 21px; } .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 13px; color: var(--muted); font-size: 12px; } .toolbar label { display: flex; align-items: center; gap: 7px; } select, input { min-height: 35px; padding: 7px 10px; border: 1px solid var(--line); border-radius: 4px; color: var(--ink); background: var(--paper); font: 13px 'Segoe UI', sans-serif; } input { width: 190px; } .table-wrap { overflow-x: auto; } table { width: 100%; min-width: 1050px; border-collapse: collapse; font-size: 12px; } th, td { padding: 13px 9px; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; } th { color: var(--muted); background: #f8fbf8; font-size: 11px; font-weight: 600; } td.empty { padding: 29px; color: var(--muted); text-align: center; } .table-footer { display: flex; justify-content: space-between; margin-top: 14px; color: var(--muted); font-size: 11px; } .pager { display: flex; gap: 14px; } .pager button { border: 0; color: var(--muted); background: transparent; cursor: pointer; } footer { margin-left: 248px; padding: 20px; color: var(--muted); text-align: center; font-size: 11px; }
    @@media (max-width: 800px) { .sidebar { width: 62px; padding-left: 14px; padding-right: 14px; } .sidebar .brand span, .sidebar nav a span, .sidebar .nav-label, .sidebar .subnav { display: none; } nav a { justify-content: center; padding: 0; } .top, footer { margin-left: 62px; } main { width: min(calc(100% - 94px), 1350px); } } @@media (max-width: 620px) { .sidebar { display: none; } .top, footer { margin-left: 0; } main { width: calc(100% - 20px); margin-top: 14px; } .panel { padding: 21px 15px 25px; } .toolbar { align-items: flex-start; flex-direction: column; gap: 10px; } input { width: 100%; } .top { padding: 0 16px; } }
</style>
}

@section Scripts {
<script src="/js/portal-table.js"></script>
<script>
  initPortalTable({
    url: '/api/commerce/purchases?page=1&pageSize=100',
    columnCount: 9,
    prevBtn: document.querySelector('#prevPage'),
    nextBtn: document.querySelector('#nextPage'),
    matches: (item, term) => `${item.productName} ${item.paymentMethod} ${item.status}`.toLowerCase().includes(term),
    searchMessage: 'No matching purchases',
    errorMessage: 'Unable to load purchases.',
    renderRow: (item, index) => `<tr><td>${index + 1}</td><td>${item.productName}</td><td>R${Number(item.amount).toFixed(2)}</td><td>${item.isBusinessKit ? 'Yes' : 'No'}</td><td>${item.quantity}</td><td>R${Number(item.total).toFixed(2)}</td><td>${item.paymentMethod}</td><td>${item.status}</td><td>${item.date}</td></tr>`
  });
</script>
}


